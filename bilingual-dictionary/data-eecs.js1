/* ---------------- 器件 · 工艺 (device) ---------------- */
  ["semiconductor","n.","ˌsemikənˈdʌktər","ˌsemikənˈdʌktə(r)",[["n.","半导体；半导体材料","a material (such as silicon) whose conductivity lies between a conductor and an insulator; a chip made of it","Silicon is the most widely used semiconductor material. 硅是应用最广泛的半导体材料。",["semiconductor industry 半导体产业","power semiconductor 功率半导体"]]],null,[["silicon","n. 硅"],["wafer","n. 晶圆"]],"半导体行业常用缩写：IC 集成电路、SoC 片上系统。","device"],
  ["MOSFET","n.","ˈmɑːsfet","ˈmɒsfet",[["n.","金属氧化物半导体场效应管","Metal-Oxide-Semiconductor Field-Effect Transistor, the most common transistor in digital ICs","Most digital chips are built from CMOS MOSFETs. 大多数数字芯片由 CMOS 工艺的 MOSFET 构成。",["power MOSFET 功率 MOSFET","NMOS / PMOS"]]],null,[["transistor","n. 晶体管"],["CMOS","n. 互补金属氧化物半导体"]],"读作 mos-fet；栅极电压控制源漏之间的电流。","device"],
  ["BJT","n.","ˌbiː dʒeɪ ˈtiː","ˌbiː dʒeɪ ˈtiː",[["n.","双极结型晶体管","Bipolar Junction Transistor, a current-controlled transistor with three terminals: base, emitter and collector","The BJT amplifies current flowing from base to collector. 双极型晶体管放大从基极流向集电极的电流。",["NPN transistor NPN 管","PNP transistor PNP 管"]]],null,[["transistor","n. 晶体管"],["amplifier","n. 放大器"]],"电流控制型器件，与电压控制的 MOSFET 相对。","device"],
  ["diode","n.","ˈdaɪoʊd","ˈdaɪəʊd",[["n.","二极管","a two-terminal device that conducts current in one direction only","The diode protects the circuit from reverse voltage. 二极管保护电路免受反向电压损坏。",["Zener diode 稳压二极管","rectifier diode 整流二极管"]]],null,[["rectifier","n. 整流器"],["LED","n. 发光二极管"]],null,"device"],
  ["LED","n.","ˌel iː ˈdiː","ˌel iː ˈdiː",[["n.","发光二极管","Light-Emitting Diode, a diode that emits light when current flows through it","The indicator LED lights up when the power is on. 电源打开时指示灯会亮起。",["LED display LED 显示屏","RGB LED 三色 LED"]]],null,[["diode","n. 二极管"],["display","n. 显示屏"]],"读作 L-E-D，通常说 an LED。","device"],
  ["photodiode","n.","ˌfoʊtoʊˈdaɪoʊd","ˌfəʊtəʊˈdaɪəʊd",[["n.","光电二极管","a diode that generates current when exposed to light, used in optical sensors","The photodiode converts light into an electrical signal. 光电二极管把光转换成电信号。"]],null,[["diode","n. 二极管"],["sensor","n. 传感器"]],null,"device"],
  ["resistor","n.","rɪˈzɪstər","rɪˈzɪstə(r)",[["n.","电阻器；电阻","a component that limits the flow of current, measured in ohms","Use a 10k resistor to limit the current through the LED. 用一个10千欧电阻限制流过 LED 的电流。",["pull-up resistor 上拉电阻","pull-down resistor 下拉电阻","series resistor 串联电阻"]]],null,[["resistance","n. 电阻"],["ohm","n. 欧姆"]],"电阻值用色环或数字标注（如 103 = 10kΩ）。","device"],
  ["capacitor","n.","kəˈpæsɪtər","kəˈpæsɪtə(r)",[["n.","电容器；电容","a component that stores electrical charge, used for filtering and decoupling","Place a decoupling capacitor near each IC power pin. 在每个芯片电源引脚旁放置去耦电容。",["decoupling capacitor 去耦电容","electrolytic capacitor 电解电容","ceramic capacitor 陶瓷电容"]]],null,[["capacitance","n. 电容"],["decoupling","n. 去耦"]],"单位是法拉 F，常用 μF / nF / pF。","device"],
  ["inductor","n.","ɪnˈdʌktər","ɪnˈdʌktə(r)",[["n.","电感器；电感","a coil that stores energy in a magnetic field, used in filters and power converters","Buck converters use an inductor to store and transfer energy. 降压转换器用电感储存和传递能量。",["coupled inductor 耦合电感","power inductor 功率电感"]]],null,[["inductance","n. 电感"],["buck","n. 降压变换器"]],"单位是亨利 H，常用 μH / nH。","device"],
  ["sensor","n.","ˈsensər","ˈsensə(r)",[["n.","传感器","a device that detects physical quantities such as temperature, light or pressure","The temperature sensor reads 25 degrees. 温度传感器读数为25度。",["temperature sensor 温度传感器","image sensor 图像传感器"]]],null,[["actuator","n. 执行器"],["transducer","n. 换能器"]],null,"device"],
  ["actuator","n.","ˈæktʃueɪtər","ˈæktʃueɪtə(r)",[["n.","执行器；致动器","a device that converts an electrical signal into physical motion","The motor actuator moves the valve. 电机执行器驱动阀门运动。"]],null,[["sensor","n. 传感器"],["motor","n. 电机"]],null,"device"],
  ["relay","n.","ˈriːleɪ","ˈriːleɪ",[["n.","继电器","an electrically operated switch that uses an electromagnet to control a circuit","The relay switches the high-voltage circuit. 继电器切换高压电路。",["solid-state relay 固态继电器"]]],null,[["switch","n. 开关"],["contactor","n. 接触器"]],"用低压小电流控制高压大电流的通断。","device"],
  ["transformer","n.","trænsˈfɔːrmər","trænsˈfɔːmə(r)",[["n.","变压器","a device that changes the voltage of alternating current","The transformer steps 220V down to 12V. 变压器把220伏降到12伏。",["step-down transformer 降压变压器","isolation transformer 隔离变压器"]]],null,[["voltage","n. 电压"],["winding","n. 绕组"]],"只能变换交流电，不能变换直流电。","device"],
  ["antenna","n.","ænˈtenə","ænˈtenə",[["n.","天线","a device that sends or receives radio waves","The PCB antenna improves the Bluetooth range. 板载天线提升了蓝牙通信距离。",["PCB antenna 板载天线","antenna gain 天线增益"]]],null,[["radio","n. 无线电"],["RF","n. 射频"]],"复数 antennas。","device"],
  ["wafer","n.","ˈweɪfər","ˈweɪfə(r)",[["n.","晶圆","a thin slice of silicon on which many chips are fabricated at once","The 12-inch wafer contains hundreds of chips. 这块12英寸晶圆上有数百颗芯片。",["wafer fab 晶圆厂","wafer test 晶圆测试"]]],null,[["die","n. 裸片"],["process","n. 工艺"]],null,"device"],
  ["die","n.","daɪ","daɪ",[["n.","裸片；芯片","the single piece of semiconductor cut from a wafer, before packaging","The die is bonded to the package substrate. 裸片被贴装到封装基板上。",["die size 裸片面积","bare die 裸片"]]],null,[["wafer","n. 晶圆"],["package","n. 封装"]],"复数通常用 die 或 dies；注意与动词 die（死亡）同形。","device"],
  ["package","n. v.","ˈpækɪdʒ","ˈpækɪdʒ",[["n.","封装；芯片外壳","the protective case around a chip with external pins or balls","This microcontroller comes in a QFP package. 这款单片机采用 QFP 封装。",["QFP package QFP 封装","BGA package BGA 封装","IC package 芯片封装"]]],null,[["pin","n. 引脚"],["substrate","n. 基板"]],null,"device"],
  ["pin","n. v.","pɪn","pɪn",[["n.","引脚；插针","a metal leg of a chip or connector that carries signals or power","Pin 5 is the chip select input. 第5脚是片选输入。",["pin definition 引脚定义","pin out 引脚排布"]],["v.","用针固定；钉住","to fix or attach with a pin","Pin the wire to the board. 把导线固定到板上。"]],null,[["socket","n. 插座"],["lead","n. 引线"]],null,"device"],
  ["socket","n.","ˈsɑːkɪt","ˈsɒkɪt",[["n.","插座；插槽","a holder that a chip or plug fits into","The CPU sits in a socket on the motherboard. CPU 插在主板上的插座里。",["IC socket IC 插座","wall socket 墙壁插座"]]],null,[["pin","n. 引脚"],["connector","n. 连接器"]],null,"device"],
  ["probe","n. v.","proʊb","prəʊb",[["n.","探针；探头","a pointed instrument or test lead used to contact a circuit point","Touch the oscilloscope probe to the test point. 把示波器探头搭在测试点上。",["oscilloscope probe 示波器探头","test probe 测试探针"]],["v.","探测；探查","to touch or examine with a probe","Probe the signal with a scope to check for glitches. 用示波器探测该信号检查毛刺。"]],null,[["oscilloscope","n. 示波器"],["test point","测试点"]],null,"device"],

/* ---------------- 模拟 (analog) ---------------- */
  ["analog","adj. n.","ˈænəlɔːɡ","ˈænəlɔːɡ",[["adj.","模拟的","representing data by continuous physical quantities such as voltage","The analog signal varies continuously with time. 模拟信号随时间连续变化。",["analog circuit 模拟电路","analog signal 模拟信号","analog-to-digital 模数转换"]],["n.","模拟量","a continuously varying quantity","The sensor outputs an analog voltage from 0 to 3.3V. 传感器输出0到3.3伏的模拟电压。"]],null,[["digital","adj. 数字的"],["continuous","adj. 连续的"]],"美式拼写 analog，英式可拼 analogue。","analog"],
  ["voltage","n.","ˈvoʊltɪdʒ","ˈvəʊltɪdʒ",[["n.","电压；电位差","the electrical potential difference between two points, measured in volts","The operating voltage of this chip is 3.3V. 这颗芯片的工作电压是3.3伏。",["supply voltage 电源电压","voltage drop 压降","voltage regulator 稳压器"]]],null,[["current","n. 电流"],["potential","n. 电位"]],"单位伏特 V；1V = 1J/C。","analog"],
  ["current","n.","ˈkɜːrənt","ˈkʌrənt",[["n.","电流","the flow of electric charge through a conductor, measured in amperes","The LED draws a current of 20 milliamps. 这个 LED 消耗20毫安的电流。",["current limit 限流","leakage current 漏电流","quiescent current 静态电流"]]],null,[["voltage","n. 电压"],["ampere","n. 安培"]],"此义项为专业义；通用义见词条首部（当前的；水流）。","analog"],
  ["resistance","n.","rɪˈzɪstəns","rɪˈzɪstəns",[["n.","电阻；阻力","the opposition to current flow, measured in ohms","Ohm's law: voltage equals current times resistance. 欧姆定律：电压等于电流乘以电阻。",["thermal resistance 热阻","contact resistance 接触电阻"]]],null,[["resistor","n. 电阻器"],["ohm","n. 欧姆"]],null,"analog"],
  ["impedance","n.","ɪmˈpiːdns","ɪmˈpiːdns",[["n.","阻抗","the total opposition to alternating current, including resistance and reactance","The input impedance of the op-amp is very high. 运放的输入阻抗非常高。",["high impedance 高阻抗","characteristic impedance 特性阻抗"]]],null,[["resistance","n. 电阻"],["reactance","n. 电抗"]],"阻抗 Z 是复数（含虚部），单位也是欧姆。","analog"],
  ["capacitance","n.","kəˈpæsɪtəns","kəˈpæsɪtəns",[["n.","电容；电容值","the ability of a component to store electric charge","Parasitic capacitance limits the maximum switching speed. 寄生电容限制了最高开关速度。",["parasitic capacitance 寄生电容","input capacitance 输入电容"]]],null,[["capacitor","n. 电容器"],["farad","n. 法拉"]],null,"analog"],
  ["inductance","n.","ɪnˈdʌktəns","ɪnˈdʌktəns",[["n.","电感；电感值","the property of a coil that opposes changes in current","The bond wire inductance causes ringing at high frequencies. 键合线电感在高频下引起振铃。",["parasitic inductance 寄生电感","mutual inductance 互感"]]],null,[["inductor","n. 电感器"],["henry","n. 亨利"]],null,"analog"],
  ["ground","n. v.","ɡraʊnd","ɡraʊnd",[["n.","地；接地；地线","the reference point of zero voltage in a circuit, often the negative rail","Connect the shield to ground at one end only. 屏蔽层只在一端接地。",["ground plane 地平面","ground loop 地环路","chassis ground 机壳地"]],["v.","使接地","to connect something to the ground","Ground the exposed metal parts for safety. 出于安全把裸露金属件接地。"]],null,[["earth","n. 地线（英式）"],["reference","n. 基准"]],"电路图中常用 GND 表示；单点接地可避免地环路噪声。","analog"],
  ["supply","n. v.","səˈplaɪ","səˈplaɪ",[["n.","电源；供电","the source that provides power to a circuit","Disconnect the supply before changing components. 更换元件前先断开电源。",["power supply 电源","supply voltage 电源电压","uninterruptible power supply 不间断电源"]]],null,[["power","n. 电源"],["regulator","n. 稳压器"]],null,"analog"],
  ["reference","n.","ˈrefrəns","ˈrefrəns",[["n.","基准；参考","a stable voltage or current used as a standard for comparison","The bandgap reference provides a 1.25V stable voltage. 带隙基准提供稳定的1.25伏电压。",["reference voltage 基准电压","reference design 参考设计"]]],null,[["bandgap","n. 带隙"],["standard","n. 标准"]],"基准源的温度系数决定了转换精度。","analog"],
  ["bias","n. v.","ˈbaɪəs","ˈbaɪəs",[["n.","偏置；偏压","a DC voltage or current set to establish the operating point of a device","Set the DC bias so the transistor works in the active region. 设置直流偏置使晶体管工作在放大区。",["DC bias 直流偏置","bias current 偏置电流","reverse bias 反向偏置"]],["v.","加偏置","to apply a bias to a circuit","The diode is biased in the forward direction. 二极管被正向偏置。"]],null,[["operating point","工作点"],["quiescent","adj. 静态的"]],"偏置错误会导致放大器失真或截止。","analog"],
  ["amplifier","n.","ˈæmplɪfaɪər","ˈæmplɪfaɪə(r)",[["n.","放大器","a circuit that increases the amplitude of a signal","The audio amplifier delivers 10 watts to the speaker. 音频放大器向扬声器输出10瓦功率。",["operational amplifier 运算放大器","power amplifier 功率放大器","low-noise amplifier 低噪声放大器"]]],null,[["op-amp","n. 运算放大器"],["gain","n. 增益"]],"放大器性能指标：增益、带宽、噪声、失真。","analog"],
  ["op-amp","n.","ˈɑːpæmp","ˈɒpæmp",[["n.","运算放大器","operational amplifier, a high-gain differential amplifier used in analog circuits","The op-amp in a voltage follower buffers the signal. 电压跟随器中的运放起缓冲作用。",["inverting amplifier 反相放大器","non-inverting amplifier 同相放大器"]]],null,[["amplifier","n. 放大器"],["feedback","n. 反馈"]],"op-amp 是 operational amplifier 的缩写，复数 op-amps。","analog"],
  ["gain","n. v.","ɡeɪn","ɡeɪn",[["n.","增益","the ratio of output to input amplitude, often in decibels","The circuit has a voltage gain of 40dB. 该电路电压增益为40分贝。",["voltage gain 电压增益","loop gain 环路增益","gain margin 增益裕度"]],["v.","获得；增加","to obtain or increase","The amplifier gains 20dB at 1kHz. 放大器在1千赫时增益20分贝。"]],null,[["amplifier","n. 放大器"],["attenuation","n. 衰减"]],"增益 = 20·log10(Vout/Vin) dB。","analog"],
  ["feedback","n.","ˈfiːdbæk","ˈfiːdbæk",[["n.","反馈","the return of part of the output to the input to control the system","Negative feedback stabilizes the gain of the amplifier. 负反馈使放大器增益稳定。",["negative feedback 负反馈","positive feedback 正反馈","feedback loop 反馈环路"]]],null,[["loop","n. 环路"],["stability","n. 稳定性"]],"负反馈提高稳定性与带宽，正反馈常用于振荡器。","analog"],
  ["bandwidth","n.","ˈbændwɪdθ","ˈbændwɪdθ",[["n.","带宽","the range of frequencies over which a circuit works correctly","The scope has a bandwidth of 100MHz. 这台示波器带宽100兆赫。",["gain-bandwidth product 增益带宽积","-3dB bandwidth -3分贝带宽"]]],null,[["frequency","n. 频率"],["speed","n. 速度"]],"示波器带宽应为被测信号最高频率的5倍以上。","analog"],
  ["offset","n. v.","ˈɔːfset","ˈɒfset",[["n.","失调；偏移","a small deviation from the ideal value, such as input offset voltage of an op-amp","The op-amp input offset voltage is 1mV maximum. 运放输入失调电压最大1毫伏。",["offset voltage 失调电压","DC offset 直流偏置误差"]],["v.","抵消；补偿","to balance or compensate","The trim resistor offsets the sensor error. 微调电阻补偿传感器误差。"]],null,[["drift","n. 漂移"],["calibration","n. 校准"]],"动词过去式 offset / offset。","analog"],
  ["noise","n.","nɔɪz","nɔɪz",[["n.","噪声；干扰","unwanted random fluctuations in a signal","The power supply ripple adds noise to the analog output. 电源纹波给模拟输出叠加了噪声。",["noise figure 噪声系数","thermal noise 热噪声","signal-to-noise ratio 信噪比"]]],null,[["interference","n. 干扰"],["SNR","n. 信噪比"]],"不可数名词；常见的还有白噪声、闪烁噪声（1/f）。","analog"],
  ["distortion","n.","dɪˈstɔːrʃn","dɪˈstɔːʃn",[["n.","失真","the unwanted change of a signal's shape or spectrum","Clipping causes harmonic distortion in the audio signal. 削波引起音频信号谐波失真。",["harmonic distortion 谐波失真","total harmonic distortion 总谐波失真"]]],null,[["linearity","n. 线性度"],["clipping","n. 削波"]],"失真衡量信号通过电路后的保真度。","analog"],
  ["linearity","n.","ˌlɪniˈærəti","ˌlɪniˈærəti",[["n.","线性度","how closely the output follows a straight-line relationship with the input","The ADC linearity error is within plus or minus one LSB. 该 ADC 线性误差在正负一个最低有效位以内。"]],null,[["distortion","n. 失真"],["accuracy","n. 精度"]],null,"analog"],
  ["saturation","n.","ˌsætʃəˈreɪʃn","ˌsætʃəˈreɪʃn",[["n.","饱和","the state where increasing input no longer changes the output; the operating region of a transistor","The output stage goes into saturation when the input is too large. 输入过大时输出级进入饱和。",["saturation region 饱和区","magnetic saturation 磁饱和"]]],null,[["linear region","线性区"],["clipping","n. 削波"]],"BJT 饱和导通、MOSFET 饱和区用于放大。","analog"],
  ["comparator","n.","kəmˈpærətər","kəmˈpærətə(r)",[["n.","比较器","a circuit that compares two voltages and outputs a digital level","The comparator output goes high when Vin exceeds Vref. 当输入电压超过基准时比较器输出高电平。",["window comparator 窗口比较器","hysteresis 迟滞"]]],null,[["op-amp","n. 运算放大器"],["threshold","n. 阈值"]],"比较器常带迟滞（hysteresis）防止抖动。","analog"],
  ["mixer","n.","ˈmɪksər","ˈmɪksə(r)",[["n.","混频器","a circuit that combines two frequencies to produce sum and difference frequencies","The RF mixer down-converts 2.4GHz to an intermediate frequency. 射频混频器把2.4吉赫下变频到中频。"]],null,[["frequency","n. 频率"],["RF","n. 射频"]],null,"analog"],
  ["filter","n. v.","ˈfɪltər","ˈfɪltə(r)",[["n.","滤波器","a circuit that passes certain frequencies and rejects others","The low-pass filter removes high-frequency noise. 低通滤波器滤除高频噪声。",["low-pass filter 低通滤波器","high-pass filter 高通滤波器","band-pass filter 带通滤波器"]],["v.","过滤","to pass a signal through a filter","Filter the supply line with a capacitor. 用电容对电源线进行滤波。"]],null,[["bandwidth","n. 带宽"],["attenuation","n. 衰减"]],"RC、LC、有源滤波器是最常见的类型。","analog"],
  ["oscillator","n.","ˈɑːsɪleɪtər","ˈɒsɪleɪtər",[["n.","振荡器","a circuit that generates a periodic signal without an external input","The crystal oscillator provides the system clock. 晶体振荡器提供系统时钟。",["crystal oscillator 晶体振荡器","ring oscillator 环形振荡器","VCO 压控振荡器"]]],null,[["clock","n. 时钟"],["frequency","n. 频率"]],null,"analog"],
  ["phase","n.","feɪz","feɪz",[["n.","相位；阶段","the position of a periodic waveform in its cycle, in degrees or radians","The two signals are 90 degrees out of phase. 这两个信号相位相差90度。",["phase noise 相位噪声","phase shift 相移","in phase 同相"]]],null,[["frequency","n. 频率"],["amplitude","n. 幅度"]],"注意区分 phase（相位）与 face（脸）的读音。","analog"],
  ["loop","n.","luːp","luːp",[["n.","环路；回路","a closed path in a circuit or control system","The phase-locked loop keeps the output locked to the reference. 锁相环使输出与基准保持锁定。",["feedback loop 反馈环路","closed loop 闭环","open loop 开环","phase-locked loop 锁相环"]]],null,[["feedback","n. 反馈"],["stability","n. 稳定性"]],"闭环系统需要检查环路增益与相位裕度保证稳定。","analog"],
  ["stability","n.","stəˈbɪləti","stəˈbɪləti",[["n.","稳定性","the ability of a system to return to steady state without oscillation","Check the phase margin to ensure loop stability. 检查相位裕度以确保环路稳定。",["phase margin 相位裕度","gain margin 增益裕度"]]],null,[["loop","n. 环路"],["oscillation","n. 振荡"]],"相位裕度通常要求大于45度。","analog"],
  ["regulator","n.","ˈreɡjuleɪtər","ˈreɡjuleɪtə(r)",[["n.","稳压器；调节器","a circuit that maintains a constant output voltage","The LDO regulator supplies a clean 3.3V rail. LDO 稳压器提供干净的3.3伏电源轨。",["voltage regulator 稳压器","linear regulator 线性稳压器","switching regulator 开关稳压器"]]],null,[["LDO","n. 低压差稳压器"],["ripple","n. 纹波"]],null,"analog"],
  ["LDO","n.","ˌel diː ˈoʊ","ˌel diː ˈoʊ",[["n.","低压差线性稳压器","Low-Dropout regulator, a linear regulator that works with a small input-output difference","Use an LDO to generate 1.8V from a 3.3V supply. 用 LDO 从3.3伏电源产生1.8伏。",["LDO dropout voltage 压差电压"]]],null,[["regulator","n. 稳压器"],["dropout","n. 压差"]],"LDO 噪声低但效率不如开关稳压器。","analog"],
  ["buck","n.","bʌk","bʌk",[["n.","降压变换器","a switching converter that steps voltage down while stepping current up","The buck converter achieves 95% efficiency at full load. 降压变换器满载效率达95%。",["buck converter 降压变换器","buck-boost 升降压变换器"]]],null,[["boost","n. 升压变换器"],["inductor","n. 电感"]],"buck 即 step-down converter，靠电感+开关管实现。","analog"],
  ["boost","n. v.","buːst","buːst",[["n.","升压变换器","a switching converter that steps voltage up","The boost converter drives the LED string at 24V. 升压变换器为 LED 灯串提供24伏驱动。",["boost converter 升压变换器"]],["v.","提升；增强","to increase","Feedback boosts the output accuracy. 反馈提升了输出精度。"]],null,[["buck","n. 降压变换器"],["charge pump","电荷泵"]],null,"analog"],
  ["ADC","n.","ˌeɪ diː ˈsiː","ˌeɪ diː ˈsiː",[["n.","模数转换器","Analog-to-Digital Converter, converts a continuous analog voltage into a digital code","The 12-bit ADC samples the sensor at 1Msps. 12位 ADC 以每秒100万次采样传感器。",["SAR ADC 逐次逼近型 ADC","delta-sigma ADC Δ-Σ ADC","resolution 分辨率"]]],null,[["DAC","n. 数模转换器"],["quantization","n. 量化"]],"ADC 的关键指标：分辨率、采样率、信噪比、非线性。","analog"],
  ["DAC","n.","ˌdiː eɪ ˈsiː","ˌdiː eɪ ˈsiː",[["n.","数模转换器","Digital-to-Analog Converter, converts a digital code into an analog voltage or current","The DAC output drives the audio amplifier. DAC 输出驱动音频放大器。",["voltage-output DAC 电压输出 DAC","R-2R DAC R-2R 阶梯 DAC"]]],null,[["ADC","n. 模数转换器"],["analog","adj. 模拟的"]],"DAC 的输出精度取决于位数与基准电压。","analog"],
  ["sample","n. v.","ˈsæmpl","ˈsæmpl",[["n.","采样；样本","a single measurement of a signal at an instant in time","Take a sample every 10 microseconds. 每10微秒采样一次。",["sample rate 采样率","sample-and-hold 采样保持"]],["v.","采样","to measure a signal at discrete times","The ADC samples the input at 1MHz. ADC 以1兆赫采样输入。"]],null,[["quantization","n. 量化"],["Nyquist","n. 奈奎斯特"]],"采样率必须大于信号最高频率的2倍（奈奎斯特定理）。","analog"],
  ["quantization","n.","ˌkwɑːntəˈzeɪʃn","ˌkwɒntɪˈzeɪʃn",[["n.","量化","the mapping of a continuous value to the nearest discrete level","Quantization introduces an error of up to half an LSB. 量化带来的误差最高可达半个最低有效位。",["quantization error 量化误差","quantization noise 量化噪声"]]],null,[["ADC","n. 模数转换器"],["resolution","n. 分辨率"]],"位数越多，量化台阶越细，误差越小。","analog"],
  ["resolution","n.","ˌrezəˈluːʃn","ˌrezəˈluːʃn",[["n.","分辨率","the smallest change a converter or display can represent","A 16-bit ADC has a resolution of 1/65536 of full scale. 16位 ADC 的分辨率为满量程的1/65536。",["high resolution 高分辨率","resolution bandwidth 分辨率带宽"]]],null,[["quantization","n. 量化"],["precision","n. 精度"]],"分辨率≠精度：分辨率指能分辨的最小变化，精度指准确性。","analog"],
  ["SNR","n.","ˌes en ˈɑːr","ˌes en ˈɑːr",[["n.","信噪比","Signal-to-Noise Ratio, the ratio of signal power to noise power in decibels","The ADC achieves an SNR of 80dB. 该 ADC 的信噪比达80分贝。",["high SNR 高信噪比","SNR improvement 信噪比提升"]]],null,[["noise","n. 噪声"],["signal","n. 信号"]],"SNR 越高，信号质量越好。","analog"],
  ["ESD","n.","ˌiː es ˈdiː","ˌiː es ˈdiː",[["n.","静电放电","Electrostatic Discharge, sudden static electricity that can damage chips","The input has built-in ESD protection diodes. 输入内置 ESD 保护二极管。",["ESD protection ESD 保护","ESD-sensitive device 静电敏感器件"]]],null,[["protection","n. 保护"],["latch-up","n. 闩锁效应"]],"拿芯片前先触摸接地金属释放静电。","analog"],

/* ---------------- 数字 (digital) ---------------- */
  ["digital","adj. n.","ˈdɪdʒɪtl","ˈdɪdʒɪtl",[["adj.","数字的","representing data as discrete binary levels (0 and 1)","Digital circuits are more immune to noise than analog ones. 数字电路比模拟电路更抗噪声。",["digital signal 数字信号","digital IC 数字集成电路","digital design 数字设计"]]],null,[["analog","adj. 模拟的"],["binary","adj. 二进制的"]],null,"digital"],
  ["logic","n.","ˈlɑːdʒɪk","ˈlɒdʒɪk",[["n.","逻辑；逻辑电路","the system of reasoning used in digital circuits; logic circuitry","Check the logic of the state machine carefully. 仔细检查状态机的逻辑。",["logic gate 逻辑门","logic analyzer 逻辑分析仪","logic level 逻辑电平"]]],null,[["gate","n. 逻辑门"],["boolean","adj. 布尔（逻辑）的"]],null,"digital"],
  ["gate","n. v.","ɡeɪt","ɡeɪt",[["n.","逻辑门","a digital circuit that implements a Boolean function","An AND gate outputs 1 only when all inputs are 1. 与门只有全部输入为1时才输出1。",["logic gate 逻辑门","AND gate 与门","clock gating 时钟门控"]],["v.","门控","to control a signal with a gate","Gate the clock to save power. 对时钟做门控以节省功耗。"]],null,[["logic","n. 逻辑"],["flip-flop","n. 触发器"]],"此义项为专业义；通用义（大门）见词条首部。","digital"],
  ["flip-flop","n.","ˈflɪpflɑːp","ˈflɪpflɒp",[["n.","触发器","a bistable circuit that stores one bit, changing state on the clock edge","The D flip-flop captures the data on the rising edge. D 触发器在上升沿锁存数据。",["D flip-flop D 触发器","JK flip-flop JK 触发器","edge-triggered 边沿触发"]]],null,[["latch","n. 锁存器"],["register","n. 寄存器"]],"边沿触发的叫 flip-flop，电平触发的叫 latch。","digital"],
  ["latch","n. v.","lætʃ","lætʃ",[["n.","锁存器","a level-sensitive storage element that holds a value while enabled","The transparent latch passes data while the enable is high. 透明锁存器在使能为高时直通数据。"]],null,[["flip-flop","n. 触发器"],["register","n. 寄存器"]],null,"digital"],
  ["register","n. v.","ˈredʒɪstər","ˈredʒɪstə(r)",[["n.","寄存器","a group of flip-flops that stores data, often controlling hardware configuration","Write 0x01 to the control register to enable the interrupt. 向控制寄存器写入0x01以使能中断。",["control register 控制寄存器","status register 状态寄存器","register map 寄存器映射"]]],null,[["flip-flop","n. 触发器"],["memory","n. 存储器"]],"此义项为专业义；通用义（登记）见词条首部。","digital"],
  ["counter","n.","ˈkaʊntər","ˈkaʊntə(r)",[["n.","计数器","a sequential circuit that counts clock pulses","The 8-bit counter overflows every 256 cycles. 8位计数器每256个周期溢出一次。",["up/down counter 可逆计数器","program counter 程序计数器"]]],null,[["flip-flop","n. 触发器"],["timer","n. 定时器"]],"此义项为专业义；通用义（柜台）见词条首部。","digital"],
  ["decoder","n.","diːˈkoʊdər","diːˈkəʊdə(r)",[["n.","译码器","a circuit that converts coded input into a set of outputs","The 3-to-8 decoder selects one of eight outputs. 3-8译码器从8个输出中选中一个。"]],null,[["encoder","n. 编码器"],["multiplexer","n. 多路选择器"]],null,"digital"],
  ["encoder","n.","ɪnˈkoʊdər","ɪnˈkəʊdə(r)",[["n.","编码器","a circuit or device that converts information into a code; a rotation/position sensor","The rotary encoder reports the motor shaft position. 旋转编码器报告电机轴位置。"]],null,[["decoder","n. 译码器"],["sensor","n. 传感器"]],null,"digital"],
  ["multiplexer","n.","ˈmʌltɪpleksər","ˈmʌltɪpleksə(r)",[["n.","多路选择器（MUX）","a circuit that selects one of several inputs and routes it to a single output","The multiplexer selects one of four data sources. 多路选择器从四个数据源中选一个。",["analog multiplexer 模拟多路选择器"]]],null,[["demultiplexer","n. 多路分配器"],["selector","n. 选择器"]],"简称 MUX。","digital"],
  ["demultiplexer","n.","diːˈmʌltɪpleksər","ˌdiːˈmʌltɪpleksə(r)",[["n.","多路分配器（DEMUX）","a circuit that routes one input to one of several outputs","The demultiplexer sends the serial data to the selected channel. 多路分配器把串行数据送到选中的通道。"]],null,[["multiplexer","n. 多路选择器"]],"简称 DEMUX。","digital"],
  ["adder","n.","ˈædər","ˈædə(r)",[["n.","加法器","a digital circuit that adds binary numbers","A full adder computes the sum and carry-out. 全加器计算和与进位输出。",["full adder 全加器","carry-lookahead adder 超前进位加法器"]]],null,[["ALU","n. 算术逻辑单元"],["carry","n. 进位"]],null,"digital"],
  ["ALU","n.","ˈæluː","ˈæluː",[["n.","算术逻辑单元","Arithmetic Logic Unit, the part of a CPU that performs arithmetic and logic operations","The ALU executes add, subtract and bitwise operations. ALU 执行加减与按位运算。",["ALU operation ALU 运算"]]],null,[["adder","n. 加法器"],["CPU","n. 中央处理器"]],null,"digital"],
  ["combinational","adj.","ˌkɑːmbəˈneɪʃənl","ˌkɒmbɪˈneɪʃənl",[["adj.","组合（逻辑）的","describing logic whose output depends only on current inputs, with no memory","Combinational logic has no internal state. 组合逻辑没有内部状态。"]],null,[["sequential","adj. 时序（逻辑）的"],["logic","n. 逻辑"]],"与顺序逻辑相对；组合逻辑+寄存器构成时序逻辑。","digital"],
  ["sequential","adj.","sɪˈkwenʃl","sɪˈkwenʃl",[["adj.","时序（逻辑）的；顺序的","describing logic whose output depends on current inputs and past state","Sequential circuits are synchronized by the clock. 时序电路由时钟同步。",["sequential logic 时序逻辑"]]],null,[["combinational","adj. 组合逻辑的"],["clock","n. 时钟"]],null,"digital"],
  ["synchronous","adj.","ˈsɪŋkrənəs","ˈsɪŋkrənəs",[["adj.","同步的","sharing a common clock or timing reference","Synchronous design avoids race conditions. 同步设计可避免竞争冒险。",["synchronous circuit 同步电路"]]],null,[["asynchronous","adj. 异步的"],["clock","n. 时钟"]],null,"digital"],
  ["asynchronous","adj.","eɪˈsɪŋkrənəs","eɪˈsɪŋkrənəs",[["adj.","异步的","not sharing a common clock; using handshaking instead","Asynchronous interfaces need handshake signals. 异步接口需要握手信号。",["asynchronous reset 异步复位"]]],null,[["synchronous","adj. 同步的"],["handshake","n. 握手"]],"跨时钟域信号需用同步器或 FIFO 处理。","digital"],
  ["clock","n. v.","klɑːk","klɒk",[["n.","时钟；时钟信号","a periodic signal that synchronizes digital circuits","The system runs at a clock frequency of 100MHz. 系统时钟频率为100兆赫。",["clock frequency 时钟频率","clock domain 时钟域","clock skew 时钟偏斜"]],["v.","为……计时","to measure time or drive with a clock","The chip clocks at 200MHz maximum. 该芯片最高运行在200兆赫。"]],null,[["oscillator","n. 振荡器"],["PLL","n. 锁相环"]],"此义项为专业义；通用义（钟表）见词条首部。","digital"],
  ["reset","n. v.","ˈriːset","ˈriːset",[["n.","复位；复位信号","the signal or action that returns a system to a known initial state","Press the reset button to restart the board. 按复位键重启开发板。",["reset signal 复位信号","power-on reset 上电复位"]],["v.","复位；清零","to set something back to its initial state","Reset the counter before starting the measurement. 开始测量前先把计数器清零。"]],null,[["interrupt","n. 中断"],["initial","adj. 初始的"]],"名词读 /ˈriːset/，动词读 /rɪˈset/；三态同形 reset-reset-reset。","digital"],
  ["bit","n.","bɪt","bɪt",[["n.","比特；位","the smallest unit of digital data, either 0 or 1","The status flag is stored in bit 3 of the register. 状态标志存储在寄存器的第3位。",["bit field 位域","MSB 最高位","LSB 最低位"]]],null,[["byte","n. 字节"],["binary","adj. 二进制的"]],"此义项为专业义；通用义（一点儿）见词条首部。","digital"],
  ["byte","n.","baɪt","baɪt",[["n.","字节","a group of 8 bits","A byte can represent 256 different values. 一个字节可表示256种不同的值。",["kilobyte 千字节","byte order 字节序"]]],null,[["bit","n. 比特"],["word","n. 字"]],"1KB=1024字节；注意发音与 bite 相同。","digital"],
  ["word","n.","wɜːrd","wɜːd",[["n.","字；字长","the natural unit of data a processor handles, e.g. 32 bits","The CPU processes one 32-bit word per cycle. CPU 每个周期处理一个32位字。",["word length 字长","data word 数据字"]]],null,[["byte","n. 字节"],["instruction","n. 指令"]],"此义项为专业义；通用义（单词）见词条首部。","digital"],
  ["bus","n.","bʌs","bʌs",[["n.","总线","a set of wires that carries data, addresses or control signals between blocks","The data bus transfers 32 bits in parallel. 数据总线并行传输32位。",["data bus 数据总线","address bus 地址总线","system bus 系统总线"]]],null,[["address","n. 地址"],["protocol","n. 协议"]],"此义项为专业义；通用义（公共汽车）见词条首部。","digital"],
  ["address","n. v.","ˈædres","əˈdres",[["n.","地址","a number that identifies a memory location or a device on a bus","Read data from address 0x1000. 从地址0x1000读取数据。",["memory address 内存地址","I2C address I2C 从机地址","address space 地址空间"]],["v.","寻址；处理","to refer to a location; to deal with a problem","The decoder addresses each memory bank. 译码器为每个存储体寻址。"]],null,[["register","n. 寄存器"],["pointer","n. 指针"]],"此义项为专业义；通用义（住址；演讲）见词条首部。","digital"],
  ["memory","n.","ˈmeməri","ˈmeməri",[["n.","存储器；内存","hardware that stores data and instructions","The chip has 256KB of on-chip memory. 芯片内置256千字节存储器。",["memory cell 存储单元","memory map 存储器映射","flash memory 闪存"]]],null,[["SRAM","n. 静态随机存储器"],["DRAM","n. 动态随机存储器"],["ROM","n. 只读存储器"]],"此义项为专业义；通用义（记忆）见词条首部。","digital"],
  ["SRAM","n.","ˈesræm","ˈesræm",[["n.","静态随机存取存储器","Static Random-Access Memory, fast but volatile memory that keeps data while powered","SRAM is used for CPU cache because it is fast. SRAM 速度快，用于 CPU 缓存。"]],null,[["DRAM","n. 动态随机存储器"],["cache","n. 缓存"]],"SRAM 不需要刷新，但单元面积大、成本高。","digital"],
  ["DRAM","n.","ˈdiːræm","ˈdiːræm",[["n.","动态随机存取存储器","Dynamic Random-Access Memory, dense but volatile memory that needs periodic refresh","DRAM stores each bit in a tiny capacitor that must be refreshed. DRAM 用微型电容存储每位数据，需要定期刷新。",["DDR SDRAM 双倍速率同步动态随机存储器"]]],null,[["SRAM","n. 静态随机存储器"],["refresh","n. 刷新"]],"容量大、成本低，是内存条的主力。","digital"],
  ["cache","n. v.","kæʃ","kæʃ",[["n.","缓存","a small fast memory that stores frequently used data","The L1 cache holds the most-used instructions. 一级缓存存放最常用的指令。",["cache memory 高速缓存","cache miss 缓存未命中"]]],null,[["SRAM","n. 静态随机存储器"],["hit","n. 命中"]],"注意发音 /kæʃ/，不读 /keɪʃ/。","digital"],
  ["ROM","n.","rɑːm","rɒm",[["n.","只读存储器","Read-Only Memory, non-volatile memory that keeps data after power-off","The boot code is stored in ROM. 引导代码存放在 ROM 中。"]],null,[["EEPROM","n. 电可擦除只读存储器"],["flash","n. 闪存"]],"读作单词 rom（/rɒm/），不是 R-O-M。","digital"],
  ["EEPROM","n.","ˈiːprɑːm","ˈiːprɒm",[["n.","电可擦除可编程只读存储器","Electrically Erasable Programmable Read-Only Memory, can be erased and reprogrammed electrically","The EEPROM stores calibration data that survives power-off. EEPROM 保存断电不丢失的校准数据。"]],null,[["ROM","n. 只读存储器"],["flash","n. 闪存"]],"读作 e-prom。","digital"],
  ["flash","n. v.","flæʃ","flæʃ",[["n.","闪存","non-volatile memory that can be erased in blocks","The firmware is stored in on-chip flash memory. 固件存储在片内闪存中。",["flash memory 闪存","NOR flash NOR 闪存","NAND flash NAND 闪存"]],["v.","烧录；闪烁","to program a memory; to shine briefly","Flash the new firmware to the board. 把新固件烧录到开发板。"]],null,[["EEPROM","n. 电可擦除只读存储器"],["firmware","n. 固件"]],"此义项为专业义；通用义（闪光）见词条首部。","digital"],
  ["FIFO","n.","ˈfaɪfoʊ","ˈfaɪfəʊ",[["n.","先进先出队列","First-In First-Out buffer, a data buffer where the oldest data is read first","A FIFO bridges the two clock domains. FIFO 桥接两个时钟域。",["asynchronous FIFO 异步 FIFO"]]],null,[["queue","n. 队列"],["clock domain","时钟域"]],"读作 fai-fo。","digital"],
  ["pipeline","n. v.","ˈpaɪplaɪn","ˈpaɪplaɪn",[["n.","流水线","a design technique that overlaps processing stages to increase throughput","The CPU uses a five-stage pipeline. 该 CPU 采用五级流水线。",["pipeline stage 流水线级","instruction pipeline 指令流水线"]]],null,[["throughput","n. 吞吐量"],["hazard","n. 冒险"]],"流水线会引入冒险（hazard）与旁路（bypass）问题。","digital"],
  ["hazard","n.","ˈhæzərd","ˈhæzəd",[["n.","冒险；危险","a condition that causes wrong results in a pipelined CPU, such as data hazards","The compiler inserts NOPs to avoid pipeline hazards. 编译器插入空操作以避免流水线冒险。",["data hazard 数据冒险","control hazard 控制冒险"]]],null,[["pipeline","n. 流水线"],["stall","n. 停顿"]],null,"digital"],
  ["instruction","n.","ɪnˈstrʌkʃn","ɪnˈstrʌkʃn",[["n.","指令","a single operation a CPU can execute, such as load or add","Fetch the instruction from the program counter address. 从程序计数器指向的地址取指令。",["instruction set 指令集","branch instruction 分支指令"]]],null,[["opcode","n. 操作码"],["assembly","n. 汇编"]],"此义项为专业义；通用义（指示；说明）见词条首部。","digital"],
  ["RISC","n.","rɪsk","rɪsk",[["n.","精简指令集计算机","Reduced Instruction Set Computer, a CPU design with simple fixed-length instructions","ARM Cortex-M is a RISC processor. ARM Cortex-M 是精简指令集处理器。",["RISC-V RISC-V 开源指令集"]]],null,[["CISC","n. 复杂指令集计算机"],["ISA","n. 指令集架构"]],"RISC-V 是近年流行的开源 RISC 指令集。","digital"],
  ["CISC","n.","sɪsk","sɪsk",[["n.","复杂指令集计算机","Complex Instruction Set Computer, a CPU design with many complex instructions","x86 processors are CISC designs. x86 处理器属于复杂指令集设计。"]],null,[["RISC","n. 精简指令集计算机"]],null,"digital"],
  ["CPU","n.","ˌsiː piː ˈjuː","ˌsiː piː ˈjuː",[["n.","中央处理器","Central Processing Unit, the core that executes instructions","The CPU runs at 1.8GHz in this design. 这颗 CPU 在此设计中运行在1.8吉赫。",["CPU core CPU 内核","dual-core CPU 双核 CPU"]]],null,[["GPU","n. 图形处理器"],["ALU","n. 算术逻辑单元"]],"读作 C-P-U。","digital"],
  ["GPU","n.","ˌdʒiː piː ˈjuː","ˌdʒiː piː ˈjuː",[["n.","图形处理器","Graphics Processing Unit, a processor optimized for parallel computation","The GPU accelerates image processing tasks. GPU 加速图像处理任务。",["GPU acceleration GPU 加速"]]],null,[["CPU","n. 中央处理器"],["parallel","adj. 并行的"]],"GPU 适合大规模并行运算（矩阵、卷积）。","digital"],
  ["DSP","n.","ˌdiː es ˈpiː","ˌdiː es ˈpiː",[["n.","数字信号处理器","Digital Signal Processor, a processor optimized for signal-processing math","The DSP filters the audio in real time. DSP 实时对音频滤波。",["DSP core DSP 内核","digital signal processing 数字信号处理"]]],null,[["signal","n. 信号"],["processor","n. 处理器"]],"DSP 擅长乘加运算（MAC）。","digital"],
  ["MCU","n.","ˌem siː ˈjuː","ˌem siː ˈjuː",[["n.","微控制器；单片机","Microcontroller Unit, a chip with CPU, memory and peripherals on one die","The MCU reads the sensor and drives the motor. 单片机读取传感器并驱动电机。",["MCU firmware MCU 固件","low-power MCU 低功耗单片机"]]],null,[["SoC","n. 片上系统"],["peripheral","n. 外设"]],"MCU 常用于嵌入式控制，如 STM32、ESP32。","digital"],
  ["SoC","n.","ˌes oʊ ˈsiː","ˌes əʊ ˈsiː",[["n.","片上系统","System-on-Chip, an IC that integrates CPU, memory and peripherals","The phone's SoC integrates the modem and GPU. 手机的 SoC 集成了调制解调器和 GPU。",["SoC design SoC 设计"]]],null,[["MCU","n. 微控制器"],["integration","n. 集成"]],"读作 S-O-C。","digital"],
  ["FPGA","n.","ˌef piː dʒiː ˈeɪ","ˌef piː dʒiː ˈeɪ",[["n.","现场可编程门阵列","Field-Programmable Gate Array, a chip whose logic can be reconfigured after manufacturing","Engineers prototype the design on an FPGA first. 工程师先在 FPGA 上验证设计。",["FPGA prototyping FPGA 原型验证","logic element 逻辑单元"]]],null,[["ASIC","n. 专用集成电路"],["HDL","n. 硬件描述语言"]],"FPGA 用查找表实现逻辑，可反复配置。","digital"],
  ["ASIC","n.","ˈeɪsɪk","ˈeɪsɪk",[["n.","专用集成电路","Application-Specific Integrated Circuit, a chip designed for one specific application","The ASIC is fabricated at a 5nm process node. 这颗 ASIC 用5纳米工艺制造。",["ASIC design flow ASIC 设计流程"]]],null,[["FPGA","n. 现场可编程门阵列"],["tapeout","n. 流片"]],"ASIC 一次性成本高（NRE），但量大后单颗成本低。","digital"],
  ["CPLD","n.","ˌsiː piː el ˈdiː","ˌsiː piː el ˈdiː",[["n.","复杂可编程逻辑器件","Complex Programmable Logic Device, a simpler programmable logic chip than FPGA","The CPLD handles the glue logic between the MCU and peripherals. CPLD 处理 MCU 与外设之间的胶合逻辑。"]],null,[["FPGA","n. 现场可编程门阵列"],["glue logic","胶合逻辑"]],null,"digital"],

/* ---------------- 接口 · 协议 (interface) ---------------- */
  ["SPI","n.","ˌes piː ˈaɪ","ˌes piː ˈaɪ",[["n.","串行外设接口","Serial Peripheral Interface, a 4-wire synchronous serial bus (SCLK, MOSI, MISO, CS)","The flash chip is connected via SPI. 闪存芯片通过 SPI 连接。",["SPI master SPI 主机","SPI clock 波特率/时钟"]]],null,[["I2C","n. I2C 总线"],["UART","n. 通用异步收发器"]],"SPI 全双工、速度快，但需要额外的片选线。","interface"],
  ["I2C","n.","ˌaɪ tuː ˈsiː","ˌaɪ tuː ˈsiː",[["n.","I²C 总线","Inter-Integrated Circuit, a 2-wire (SCL, SDA) serial bus with device addresses","The sensor sits on the I2C bus at address 0x48. 传感器在 I2C 总线上地址为0x48。",["I2C address 从机地址","I2C master/slave 主/从机"]]],null,[["SPI","n. 串行外设接口"],["protocol","n. 协议"]],"读作 I-squared-C；只用两根线，支持多从机。","interface"],
  ["UART","n.","ˈjuːɑːrt","ˈjuːɑːt",[["n.","通用异步收发器","Universal Asynchronous Receiver-Transmitter, a simple 2-wire serial interface (TX, RX)","Log debug messages through the UART at 115200 baud. 通过 UART 以115200波特率输出调试日志。",["UART baud rate 波特率"]]],null,[["SPI","n. 串行外设接口"],["baud rate","波特率"]],"异步传输，无时钟线，需要约定波特率。","interface"],
  ["USB","n.","ˌjuː es ˈbiː","ˌjuː es ˈbiː",[["n.","通用串行总线","Universal Serial Bus, the standard interface for connecting peripherals to computers","Plug the USB cable into the debug port. 把 USB 线插到调试口。",["USB port USB 接口","USB-C USB-C 接口"]]],null,[["protocol","n. 协议"],["connector","n. 连接器"]],"读作 U-S-B。","interface"],
  ["GPIO","n.","ˌdʒiː piː aɪ ˈoʊ","ˌdʒiː piː aɪ ˈəʊ",[["n.","通用输入输出引脚","General-Purpose Input/Output, configurable digital pins on a chip","Set the GPIO high to turn on the LED. 把 GPIO 置高电平点亮 LED。",["GPIO pin GPIO 引脚","GPIO interrupt GPIO 中断","pull-up configuration 上拉配置"]]],null,[["pin","n. 引脚"],["input","n. 输入"],["output","n. 输出"]],"GPIO 可配置为输入、输出、开漏、上拉/下拉等模式。","interface"],
  ["PWM","n.","ˌpiː ˌdʌbljuː ˈem","ˌpiː ˌdʌbljuː ˈem",[["n.","脉冲宽度调制","Pulse-Width Modulation, a technique that varies the duty cycle to control power","Use PWM to dim the LED or control motor speed. 用 PWM 调光或控制电机转速。",["PWM duty cycle 占空比","PWM frequency PWM 频率"]]],null,[["duty cycle","占空比"],["modulation","n. 调制"]],"读作 P-W-M；平均功率由占空比决定。","interface"],
  ["DMA","n.","ˌdiː em ˈeɪ","ˌdiː em ˈeɪ",[["n.","直接存储器访问","Direct Memory Access, hardware that moves data without CPU involvement","Use DMA to transfer ADC samples to memory. 用 DMA 把 ADC 采样数据传输到内存。",["DMA channel DMA 通道","DMA transfer DMA 传输"]]],null,[["interrupt","n. 中断"],["memory","n. 存储器"]],"DMA 释放 CPU，是高性能嵌入式系统的关键。","interface"],
  ["CAN","n.","kæn","kæn",[["n.","控制器局域网络","Controller Area Network, a robust differential serial bus used in automotive","The engine ECU communicates over the CAN bus. 发动机 ECU 通过 CAN 总线通信。",["CAN bus CAN 总线","CAN transceiver CAN 收发器"]]],null,[["bus","n. 总线"],["transceiver","n. 收发器"]],"CAN 是差分总线，抗干扰强，用于汽车电子。","interface"],
  ["Ethernet","n.","ˈiːθərnet","ˈiːθənet",[["n.","以太网","the most common wired local network standard","The board connects to the network via Ethernet. 开发板通过以太网接入网络。",["Ethernet PHY 以太网物理层芯片","Ethernet switch 以太网交换机"]]],null,[["PHY","n. 物理层"],["MAC","n. 介质访问控制层"]],"以太网接口通常需要 PHY 芯片。","interface"],
  ["RS-232","n.","ˌɑːr es ˌtuː θriː ˈtuː","ˌɑːr es ˌtuː θriː ˈtuː",[["n.","RS-232 串行接口标准","an older serial communication standard with voltage levels of plus/minus 12V","The industrial machine still uses RS-232 for control. 这台工业设备仍用 RS-232 通信。"]],null,[["UART","n. 通用异步收发器"],["serial","adj. 串行的"]],"RS-232 电平（±12V）与 TTL 电平（0/3.3V）不同。","interface"],
  ["JTAG","n.","ˈdʒeɪtæɡ","ˈdʒeɪtæɡ",[["n.","JTAG 调试/测试接口","Joint Test Action Group, a 4-5 wire interface for debugging and boundary-scan testing","Flash the MCU through the JTAG connector. 通过 JTAG 接口烧录单片机。",["JTAG debugger JTAG 调试器","SWD 串行线调试（ARM）"]]],null,[["debugger","n. 调试器"],["boundary scan","边界扫描"]],"读作 jay-tag；ARM 芯片常用更精简的 SWD 接口。","interface"],
  ["HDMI","n.","ˌeɪtʃ diː em ˈaɪ","ˌeɪtʃ diː em ˈaɪ",[["n.","高清多媒体接口","High-Definition Multimedia Interface, a digital video/audio interface","Connect the monitor with an HDMI cable. 用 HDMI 线连接显示器。",["HDMI port HDMI 接口","HDMI cable HDMI 线缆"]]],null,[["display","n. 显示器"],["interface","n. 接口"]],"读作 H-D-M-I。","interface"],
  ["MIPI","n.","ˈmɪpi","ˈmɪpi",[["n.","移动行业处理器接口","Mobile Industry Processor Interface, a set of standards for cameras, displays and radios in mobile chips","The camera module uses the MIPI CSI interface. 摄像头模组使用 MIPI CSI 接口。",["MIPI CSI 摄像头串行接口","MIPI DSI 显示屏串行接口"]]],null,[["interface","n. 接口"],["camera","n. 摄像头"]],"MIPI 是差分高速串行接口。","interface"],
  ["PCIe","n.","ˌpiː siː aɪ ˈiː","ˌpiː siː aɪ ˈiː",[["n.","高速外设互连","Peripheral Component Interconnect Express, a high-speed serial bus for expansion cards","The NVMe SSD connects through four PCIe lanes. NVMe 固态硬盘通过四条 PCIe 通道连接。",["PCIe lane PCIe 通道","PCIe slot PCIe 插槽"]]],null,[["interface","n. 接口"],["bandwidth","n. 带宽"]],"读作 P-C-I-E 或 PCI Express。","interface"],
  ["DDR","n.","ˌdiː diː ˈɑːr","ˌdiː diː ˈɑːr",[["n.","双倍数据速率内存","Double Data Rate, a DRAM standard that transfers data on both clock edges","The board uses DDR4 memory running at 3200MT/s. 该主板使用速率3200MT/s 的 DDR4 内存。",["DDR3 / DDR4 / DDR5","DDR controller DDR 控制器"]]],null,[["DRAM","n. 动态随机存储器"],["memory","n. 内存"]],"读作 D-D-R。","interface"],
  ["protocol","n.","ˈproʊtəkɔːl","ˈprəʊtəkɒl",[["n.","协议","a set of rules that defines how devices exchange data","The chip supports the Modbus protocol. 该芯片支持 Modbus 协议。",["communication protocol 通信协议","protocol stack 协议栈"]]],null,[["interface","n. 接口"],["standard","n. 标准"]],null,"interface"],
  ["handshake","n.","ˈhændʃeɪk","ˈhændʃeɪk",[["n.","握手（信号）","the exchange of control signals to establish communication","The UART uses no handshake in this simple design. 这个简单设计中 UART 不使用握手信号。",["hardware handshake 硬件握手"]]],null,[["protocol","n. 协议"],["acknowledge","n. 应答"]],"握手信号如 RTS/CTS、ACK/NACK。","interface"],
  ["interrupt","n. v.","ˈɪntərʌpt","ˈɪntərʌpt",[["n.","中断","a signal that makes the CPU stop current work and run a handler","The timer interrupt fires every millisecond. 定时器中断每毫秒触发一次。",["interrupt handler 中断处理程序","interrupt priority 中断优先级","maskable interrupt 可屏蔽中断"]],["v.","打断；中断","to stop something temporarily","The new input interrupts the current task. 新输入打断了当前任务。"]],null,[["ISR","n. 中断服务程序"],["handler","n. 处理程序"]],"此义项为专业义；名词重音在前 /ˈɪntərʌpt/，动词重音在后 /ˌɪntəˈrʌpt/。","interface"],
  ["ISR","n.","ˌaɪ es ˈɑːr","ˌaɪ es ˈɑːr",[["n.","中断服务程序","Interrupt Service Routine, the code that runs when an interrupt occurs","Keep the ISR short to avoid missing other interrupts. 中断服务程序要尽量短，以免错过其他中断。"]],null,[["interrupt","n. 中断"],["handler","n. 处理程序"]],"ISR 中应避免长时间阻塞操作。","interface"],

/* ---------------- 设计 · EDA (eda) ---------------- */
  ["schematic","n. adj.","skiːˈmætɪk","skiːˈmætɪk",[["n.","原理图","a symbolic drawing of a circuit showing connections between components","Check the schematic before laying out the PCB. 布线前先检查原理图。",["schematic capture 原理图绘制","schematic symbol 原理图符号"]]],null,[["netlist","n. 网表"],["layout","n. 版图"]],"原理图强调逻辑连接，不反映物理尺寸。","eda"],
  ["netlist","n.","ˈnetlɪst","ˈnetlɪst",[["n.","网表","a list of components and their interconnections extracted from a schematic","Run DRC on the netlist to find shorted nets. 对网表做 DRC 检查找出短路网络。"]],null,[["schematic","n. 原理图"],["net","n. 网络"]],null,"eda"],
  ["layout","n. v.","ˈleɪaʊt","ˈleɪaʊt",[["n.","版图；布局","the physical arrangement of components and wires on a chip or PCB","The analog layout must match the sensitive devices carefully. 模拟版图需要仔细匹配敏感器件。",["IC layout 版图设计","layout rule 版图规则","PCB layout PCB 布局布线"]]],null,[["placement","n. 布局"],["routing","n. 布线"]],"芯片版图决定寄生参数与匹配性能。","eda"],
  ["floorplan","n.","ˈflɔːrplæn","ˈflɔːplæn",[["n.","布图规划","the early planning of block positions on a chip or PCB","The floorplan places the power-hungry blocks near the pads. 布图规划把功耗大的模块放在焊盘附近。"]],null,[["placement","n. 布局"],["routing","n. 布线"]],"好的布图规划能减少布线拥塞与压降。","eda"],
  ["placement","n.","ˈpleɪsmənt","ˈpleɪsmənt",[["n.","布局（EDA 步骤）","the automatic placement of standard cells in a design flow","The tool performs placement after synthesis. 工具在综合之后执行布局。",["cell placement 单元布局"]]],null,[["routing","n. 布线"],["synthesis","n. 综合"]],"布局与布线合称 P&R。","eda"],
  ["routing","n.","ˈruːtɪŋ","ˈraʊtɪŋ",[["n.","布线","the step of connecting placed cells with metal wires","Routing congestion increased after the ECO. ECO 之后布线拥塞加剧。",["routing congestion 布线拥塞","signal routing 信号布线"]]],null,[["placement","n. 布局"],["net","n. 网络"]],"布线需满足设计规则（DRC）与时序要求。","eda"],
  ["synthesis","n.","ˈsɪnθəsɪs","ˈsɪnθəsɪs",[["n.","综合","the process of converting RTL code into a gate-level netlist","Logic synthesis maps Verilog to standard cells. 逻辑综合把 Verilog 映射为标准单元。",["logic synthesis 逻辑综合","RTL synthesis RTL 综合"]]],null,[["RTL","n. 寄存器传输级"],["netlist","n. 网表"]],"综合的输入是 RTL，输出是门级网表。","eda"],
  ["simulation","n.","ˌsɪmjuˈleɪʃn","ˌsɪmjuˈleɪʃn",[["n.","仿真；模拟","running a model of the design to verify its behavior","Run simulation to verify the counter counts correctly. 运行仿真验证计数器计数正确。",["functional simulation 功能仿真","timing simulation 时序仿真","SPICE simulation SPICE 仿真"]]],null,[["verification","n. 验证"],["testbench","n. 测试平台"]],"仿真只能证明设计存在 bug，不能证明没有 bug。","eda"],
  ["verification","n.","ˌverɪfɪˈkeɪʃn","ˌverɪfɪˈkeɪʃn",[["n.","验证","the process of proving that a design meets its specification","Formal verification complements simulation coverage. 形式化验证补充仿真覆盖率。",["functional verification 功能验证","formal verification 形式化验证"]]],null,[["simulation","n. 仿真"],["coverage","n. 覆盖率"]],"验证占芯片开发周期的一半以上。","eda"],
  ["testbench","n.","ˈtestbentʃ","ˈtestbentʃ",[["n.","测试平台","the simulation code that generates stimuli and checks the design under test","Write a testbench that drives the clock and resets the DUT. 编写测试平台驱动时钟并复位被测设计。"]],null,[["DUT","n. 被测设计"],["stimulus","n. 激励"]],"测试平台包含激励生成与结果检查。","eda"],
  ["coverage","n.","ˈkʌvərɪdʒ","ˈkʌvərɪdʒ",[["n.","覆盖率","a metric of how much of the design has been exercised by tests","The test achieves 95% line coverage. 该测试达到95%的语句覆盖率。",["code coverage 代码覆盖率","functional coverage 功能覆盖率","coverage closure 覆盖率收敛"]]],null,[["verification","n. 验证"],["metric","n. 指标"]],"覆盖率收敛是验证完备的重要标志。","eda"],
  ["DRC","n.","ˌdiː ɑːr ˈsiː","ˌdiː ɑːr ˈsiː",[["n.","设计规则检查","Design Rule Check, verifies that the layout obeys manufacturing rules","The layout has three DRC violations to fix. 版图有三处 DRC 违例需要修复。",["DRC clean DRC 通过","minimum spacing 最小间距"]]],null,[["LVS","n. 版图原理图一致性检查"],["rule","n. 规则"]],"DRC 保证版图可制造（如最小线宽、间距）。","eda"],
  ["LVS","n.","ˌel viː ˈes","ˌel viː ˈes",[["n.","版图与原理图一致性检查","Layout vs. Schematic, verifies the layout matches the schematic","Run LVS after DRC to confirm connectivity. DRC 之后运行 LVS 确认连接关系一致。"]],null,[["DRC","n. 设计规则检查"],["netlist","n. 网表"]],"LVS 确保版图连接与原理图网络一致。","eda"],
  ["tapeout","n. v.","ˈteɪpaʊt","ˈteɪpaʊt",[["n.","流片","the final release of the design to the foundry for fabrication","The chip went to tapeout after three months of verification. 经过三个月验证后芯片流片。",["first silicon 首次流片"]]],null,[["mask","n. 掩模"],["foundry","n. 晶圆代工厂"]],"流片成本高，通常需要反复检查和 ECO。","eda"],
  ["mask","n. v.","mæsk","mɑːsk",[["n.","掩模；光罩","the patterned plate used in photolithography to define each layer","Each metal layer needs its own mask. 每层金属都需要一张掩模。",["mask layer 掩模层","reticle 掩模版"]]],null,[["tapeout","n. 流片"],["photolithography","n. 光刻"]],"掩模套刻对准决定最小特征尺寸。","eda"],
  ["process","n. v.","ˈprɑːses","ˈprəʊses",[["n.","工艺；制程","the fabrication technology, such as 28nm CMOS","This design targets a 28nm process. 该设计面向28纳米工艺。",["process node 工艺节点","process corner 工艺角","foundry process 代工厂工艺"]],["v.","处理","to handle data","The DSP processes the samples in real time. DSP 实时处理采样数据。"]],null,[["node","n. 节点"],["wafer","n. 晶圆"]],"工艺越小（如5nm），速度越快、功耗越低但成本越高。","eda"],
  ["node","n.","noʊd","nəʊd",[["n.","工艺节点；节点","the technology generation of a process; a point in a network","The chip is built on a 5nm node. 该芯片采用5纳米工艺节点制造。",["process node 工艺节点"]]],null,[["process","n. 工艺"],["technology","n. 技术"]],null,"eda"],
  ["library","n.","ˈlaɪbreri","ˈlaɪbrəri",[["n.","标准单元库；库","a collection of standard cells or IP blocks used in design","The synthesis tool reads the timing library to optimize speed. 综合工具读取时序库进行速度优化。",["standard cell library 标准单元库","timing library 时序库","IP library IP 库"]]],null,[["standard cell","标准单元"],["IP","n. 知识产权核"]],"此义项为专业义；通用义（图书馆）见词条首部。","eda"],
  ["timing","n.","ˈtaɪmɪŋ","ˈtaɪmɪŋ",[["n.","时序","the timing relationships between clock and data in a digital design","Fix the timing violation on the critical path. 修复关键路径上的时序违例。",["timing closure 时序收敛","timing violation 时序违例","setup time 建立时间","hold time 保持时间"]]],null,[["constraint","n. 约束"],["STA","n. 静态时序分析"]],"建立/保持时间不满足会导致芯片功能错误。","eda"],
  ["constraint","n.","kənˈstreɪnt","kənˈstreɪnt",[["n.","约束","design requirements given to tools, such as clock period and input delays","Write timing constraints for each clock domain. 为每个时钟域编写时序约束。",["timing constraint 时序约束","design constraint 设计约束"]]],null,[["timing","n. 时序"],["SDC","n. 标准设计约束格式"]],"SDC 文件是约束的标准格式。","eda"],
  ["STA","n.","ˌes tiː ˈeɪ","ˌes tiː ˈeɪ",[["n.","静态时序分析","Static Timing Analysis, checks all timing paths without simulation","STA reports the worst setup and hold violations. 静态时序分析报告最差的建立/保持违例。",["STA signoff 时序签核"]]],null,[["timing","n. 时序"],["signoff","n. 签核"]],"STA 覆盖所有路径，比仿真更全面。","eda"],
  ["DFT","n.","ˌdiː ef ˈtiː","ˌdiː ef ˈtiː",[["n.","可测试性设计","Design for Test, techniques that make chips testable after manufacturing","Add scan chains for DFT to improve test coverage. 为 DFT 加入扫描链以提升测试覆盖率。",["scan chain 扫描链","BIST 内建自测试"]]],null,[["test","n. 测试"],["scan","n. 扫描"]],"DFT 结构在测试模式下工作，正常模式下旁路。","eda"],
  ["EDA","n.","ˌiː diː ˈeɪ","ˌiː diː ˈeɪ",[["n.","电子设计自动化","Electronic Design Automation, software tools for designing chips and PCBs","The EDA tools run synthesis, place and route. EDA 工具执行综合、布局与布线。",["EDA tool EDA 工具","EDA flow EDA 流程"]]],null,[["tool","n. 工具"],["design flow","设计流程"]],"主要 EDA 厂商：Synopsys、Cadence、Siemens EDA。","eda"],
  ["SPICE","n.","spaɪs","spaɪs",[["n.","SPICE 电路仿真程序","Simulation Program with Integrated Circuit Emphasis, the standard analog circuit simulator","Run a SPICE simulation to check the DC operating point. 运行 SPICE 仿真检查直流工作点。",["SPICE model SPICE 模型","HSPICE / LTspice"]]],null,[["simulation","n. 仿真"],["netlist","n. 网表"]],"读作 spice；LTspice、HSPICE 都是其商业实现。","eda"],
  ["corner","n.","ˈkɔːrnər","ˈkɔːnə(r)",[["n.","工艺角；极端情况","a combination of process, voltage and temperature extremes used in verification","Verify the design at the SS and FF corners. 在慢慢（SS）与快快（FF）工艺角下验证设计。",["process corner 工艺角","PVT corner PVT 工艺角"]]],null,[["PVT","n. 工艺电压温度"],["worst case","最坏情况"]],"此义项为专业义；通用义（角落）见词条首部。","eda"],
  ["PVT","n.","ˌpiː viː ˈtiː","ˌpiː viː ˈtiː",[["n.","工艺、电压、温度","Process, Voltage and Temperature, the three parameters that vary chip performance","Chip speed varies across the PVT range. 芯片速度随工艺-电压-温度范围变化。",["PVT variation PVT 波动"]]],null,[["corner","n. 工艺角"],["variation","n. 波动"]],"芯片验收需覆盖所有 PVT 组合。","eda"],
  ["ECO","n.","ˈiːkoʊ","ˈiːkəʊ",[["n.","工程变更单","Engineering Change Order, a late-stage logic change made on the netlist or layout","We applied an ECO to fix the reset bug. 我们通过 ECO 修复了复位 bug。",["functional ECO 功能 ECO","metal fix 金属层修改"]]],null,[["netlist","n. 网表"],["patch","n. 补丁"]],"ECO 尽量只改金属层，避免重新流片全部掩模。","eda"],

/* ---------------- 系统 · 嵌入式 (system) ---------------- */
  ["firmware","n.","ˈfɜːrmwer","ˈfɜːmweə(r)",[["n.","固件","software stored in non-volatile memory that controls hardware","Update the firmware to fix the USB bug. 更新固件修复 USB 的 bug。",["firmware update 固件升级","firmware engineer 固件工程师"]]],null,[["software","n. 软件"],["hardware","n. 硬件"]],"固件介于硬件与软件之间，常驻于 flash/ROM。","system"],
  ["hardware","n.","ˈhɑːrdwer","ˈhɑːdweə(r)",[["n.","硬件","the physical components of a computer or system","The hardware team delivered the first prototype board. 硬件团队交付了第一块原型板。",["hardware design 硬件设计","hardware debugging 硬件调试"]]],null,[["software","n. 软件"],["firmware","n. 固件"]],"不可数名词，不说 a hardware。","system"],
  ["software","n.","ˈsɔːftwer","ˈsɒftweə(r)",[["n.","软件","the programs and instructions that run on hardware","Write software that talks to the I2C sensor. 编写与 I2C 传感器通信的软件。",["software engineer 软件工程师","embedded software 嵌入式软件"]]],null,[["hardware","n. 硬件"],["program","n. 程序"]],"不可数名词；一条程序说 a piece of software。","system"],
  ["RTOS","n.","ˌɑːr tiː oʊ ˈes","ˌɑːr tiː əʊ ˈes",[["n.","实时操作系统","Real-Time Operating System, an OS that guarantees task deadlines","FreeRTOS is a popular open-source RTOS. FreeRTOS 是流行的开源实时操作系统。",["RTOS task 任务","RTOS scheduling 调度"]]],null,[["task","n. 任务"],["scheduler","n. 调度器"]],"实时性体现在确定性调度（如优先级抢占）。","system"],
  ["bootloader","n.","ˈbuːtloʊdər","ˈbuːtləʊdə(r)",[["n.","引导程序；启动加载器","the code that runs first and loads the application or operating system","The bootloader jumps to the application after checking the CRC. 引导程序校验 CRC 后跳转到应用程序。"]],null,[["firmware","n. 固件"],["boot","v. 启动"]],null,"system"],
  ["debug","v. n.","ˌdiːˈbʌɡ","ˌdiːˈbʌɡ",[["v.","调试","to find and fix errors in hardware or software","Debug the startup crash with a logic analyzer. 用逻辑分析仪调试启动崩溃问题。",["debug mode 调试模式","debug interface 调试接口"]],["n.","调试","the process of finding bugs","The debug took two days. 调试花了两天。"]],null,[["debugger","n. 调试器"],["bug","n. 缺陷"]],"过去式 debugged，现在分词 debugging（双写 g）。","system"],
  ["debugger","n.","ˌdiːˈbʌɡər","ˌdiːˈbʌɡə(r)",[["n.","调试器","a tool (hardware or software) used to control and inspect a running program","Set a breakpoint in the debugger at the faulting line. 在调试器中故障行设置断点。",["JTAG debugger JTAG 调试器","breakpoint 断点"]]],null,[["debug","v. 调试"],["breakpoint","n. 断点"]],null,"system"],
  ["oscilloscope","n.","əˈsɪləskoʊp","əˈsɪləskəʊp",[["n.","示波器","an instrument that displays voltage waveforms over time","Probe the clock line with the oscilloscope to check the duty cycle. 用示波器测量时钟线检查占空比。",["digital oscilloscope 数字示波器","sampling rate 采样率"]]],null,[["probe","n. 探头"],["waveform","n. 波形"]],"示波器带宽与采样率是核心指标。","system"],
  ["multimeter","n.","ˈmʌltimiːtər","ˈmʌltimiːtə(r)",[["n.","万用表","a handheld instrument that measures voltage, current and resistance","Check the battery voltage with a multimeter. 用万用表测量电池电压。",["digital multimeter 数字万用表"]]],null,[["measurement","n. 测量"],["voltage","n. 电压"]],null,"system"],
  ["datasheet","n.","ˈdeɪtəʃiːt","ˈdeɪtəʃiːt",[["n.","数据手册","an official document describing a chip's features, pins and electrical specifications","Read the datasheet for the maximum input voltage. 查阅数据手册了解最大输入电压。",["datasheet specification 数据手册规格"]]],null,[["specification","n. 规格"],["manual","n. 手册"]],"看芯片先看 datasheet 的绝对最大额定值。","system"],
  ["errata","n.","ɪˈrɑːtə","ɪˈrɑːtə",[["n.","勘误表","a list of known silicon bugs and workarounds published by the chip maker","Check the chip errata before designing the board. 设计电路板前先查阅芯片勘误表。",["silicon errata 硅片勘误"]]],null,[["bug","n. 缺陷"],["workaround","n. 规避方法"]],"errata 是 erratum 的复数；不可数用法常见。","system"],
  ["benchmark","n. v.","ˈbentʃmɑːrk","ˈbentʃmɑːk",[["n.","基准测试","a standard test used to compare performance","The CoreMark benchmark measures CPU efficiency. CoreMark 基准测试衡量 CPU 效率。"]],null,[["performance","n. 性能"],["score","n. 得分"]],"嵌入式常用 CoreMark、EEMBC 基准。","system"],
  ["prototype","n. v.","ˈproʊtətaɪp","ˈprəʊtətaɪp",[["n.","原型；样机","an early working version of a product used for testing","Build a prototype on a breadboard first. 先在面包板上搭一个原型。",["prototype board 原型板","rapid prototyping 快速原型"]]],null,[["breadboard","n. 面包板"],["sample","n. 样片"]],null,"system"],
  ["watchdog","n.","ˈwɑːtʃdɔːɡ","ˈwɒtʃdɒɡ",[["n.","看门狗（定时器）","a timer that resets the system if the software stops responding","Enable the watchdog to recover from system hangs. 使能看门狗以从系统死机中恢复。",["watchdog timer 看门狗定时器","feed the watchdog 喂狗"]]],null,[["timer","n. 定时器"],["reset","n. 复位"]],"软件需周期性「喂狗」，否则系统自动复位。","system"],
  ["polling","n.","ˈpoʊlɪŋ","ˈpəʊlɪŋ",[["n.","轮询","repeatedly checking a device or flag instead of using interrupts","Polling the button wastes CPU time compared with interrupts. 与中断相比，轮询按键浪费 CPU 时间。",["polling loop 轮询循环"]]],null,[["interrupt","n. 中断"],["busy-wait","忙等待"]],"轮询实现简单，但实时性差、功耗高。","system"],
  ["stack","n. v.","stæk","stæk",[["n.","栈；堆栈","a last-in-first-out memory region for function calls and local data","A stack overflow caused the system to crash. 栈溢出导致系统崩溃。",["call stack 调用栈","stack pointer 栈指针"]],["v.","堆叠","to arrange in a stack","Stack the boards with spacers between them. 用垫片把板子叠放起来。"]],null,[["heap","n. 堆"],["pointer","n. 指针"]],"嵌入式开发要注意栈大小与溢出保护。","system"],
  ["heap","n.","hiːp","hiːp",[["n.","堆","the memory region used for dynamic allocation at run time","Frequent malloc/free fragments the heap. 频繁的 malloc/free 会使堆碎片化。",["heap memory 堆内存","heap overflow 堆溢出"]]],null,[["stack","n. 栈"],["memory","n. 内存"]],"MCU 上慎用动态内存分配。","system"],

/* ---------------- 电源 (power) ---------------- */
  ["power","n. v.","ˈpaʊər","ˈpaʊə(r)",[["n.","电源；功率","electrical energy supply; the rate of energy use, measured in watts","Disconnect the power before servicing the board. 维修电路板前断开电源。",["power supply 电源","power dissipation 功耗","power management 电源管理","low power 低功耗"]],["v.","供电；给……供电","to supply power to something","This rail powers the digital core. 这条电源轨为数字内核供电。"]],null,[["supply","n. 电源"],["efficiency","n. 效率"],["ripple","n. 纹波"]],"此义项为专业义；通用义与名言例句见词条首部。","power"],
  ["efficiency","n.","ɪˈfɪʃnsi","ɪˈfɪʃnsi",[["n.","效率","the ratio of output power to input power, usually as a percentage","The switching regulator achieves 90% efficiency. 开关稳压器效率达90%。",["power efficiency 电源效率","conversion efficiency 转换效率"]]],null,[["power","n. 功率"],["loss","n. 损耗"]],null,"power"],
  ["ripple","n.","ˈrɪpl","ˈrɪpl",[["n.","纹波","the small periodic variation of a DC output voltage","Add a larger output capacitor to reduce ripple. 加大输出电容以减小纹波。",["output ripple 输出纹波","ripple voltage 纹波电压"]]],null,[["noise","n. 噪声"],["filter","n. 滤波器"]],"纹波与噪声不同：纹波是与开关频率同步的周期波动。","power"],
  ["dropout","n.","ˈdrɑːpaʊt","ˈdrɒpaʊt",[["n.","压差","the minimum input-output voltage difference a linear regulator needs","The LDO's dropout voltage is only 150mV. 该 LDO 压差只有150毫伏。",["dropout voltage 压差电压"]]],null,[["LDO","n. 低压差稳压器"],["headroom","n. 余量"]],"压差越小，可用输入范围越大。","power"],
  ["load","n. v.","loʊd","ləʊd",[["n.","负载","the device or circuit that draws current from a supply","The load draws 2A at full power. 满载时负载消耗2安培电流。",["load current 负载电流","full load 满载","load regulation 负载调整率"]],["v.","加载；装载","to put data or a program into memory","Load the firmware through the USB port. 通过 USB 端口加载固件。"]],null,[["output","n. 输出"],["current","n. 电流"]],"负载调整率衡量输出电压随负载的变化。","power"],
  ["input","n. v.","ˈɪnpʊt","ˈɪnpʊt",[["n.","输入；输入信号","the signal or connection that feeds a circuit","The ADC input range is 0 to 3.3V. ADC 输入范围是0到3.3伏。",["input voltage 输入电压","input impedance 输入阻抗","digital input 数字输入"]],["v.","输入","to enter data","Input the calibration values via UART. 通过 UART 输入校准值。"]],null,[["output","n. 输出"],["source","n. 源"]],"过去式/过去分词 input 或 inputted。","power"],
  ["output","n. v.","ˈaʊtpʊt","ˈaʊtpʊt",[["n.","输出；输出信号","the signal or connection that a circuit produces","The sensor output is a 0-5V analog voltage. 传感器输出0到5伏模拟电压。",["output voltage 输出电压","output current 输出电流","open-drain output 开漏输出"]],["v.","输出","to produce data","The chip outputs the result on the data bus. 芯片在数据总线上输出结果。"]],null,[["input","n. 输入"],["driver","n. 驱动"]],"过去式/过去分词 output 或 outputted。","power"],
  ["switching","n. adj.","ˈswɪtʃɪŋ","ˈswɪtʃɪŋ",[["n.","开关（电源）技术；切换","the technique of rapidly switching transistors to convert power","Switching regulators are more efficient than linear ones. 开关稳压器比线性稳压器效率更高。",["switching regulator 开关稳压器","switching frequency 开关频率","switching loss 开关损耗"]]],null,[["buck","n. 降压变换器"],["efficiency","n. 效率"]],"开关电源以频率换效率，但噪声更大。","power"],
  ["linear","adj.","ˈlɪniər","ˈlɪniə(r)",[["adj.","线性的","having a straight-line input-output relationship; using a linear (non-switching) regulator","Linear regulators are simple but inefficient at high drop. 线性稳压器简单，但压差大时效率低。",["linear regulator 线性稳压器","linear region 线性区"]]],null,[["switching","n. 开关电源"],["regulator","n. 稳压器"]],"线性稳压器噪声小、瞬态好。","power"],

/* ============ 模拟 IC 扩充：放大器与基本模块 (analog) ============ */
  ["buffer","n. v.","ˈbʌfər","ˈbʌfə(r)",[["n.","缓冲器","a unity-gain amplifier that isolates stages or drives heavy loads","Add a buffer between the sensor and the ADC input. 在传感器与 ADC 输入之间加一个缓冲器。",["voltage buffer 电压缓冲器","input buffer 输入缓冲"]],["v.","缓冲","to isolate or protect with a buffer","The gate driver buffers the PWM signal. 栅极驱动器对 PWM 信号做缓冲。"]],null,[["voltage follower","n. 电压跟随器"],["op-amp","n. 运算放大器"]],"缓冲器增益为1，主要用于阻抗隔离与驱动能力提升。","analog"],
  ["voltage follower","n.","ˈvoʊltɪdʒ ˈfɑːloʊər","ˈvəʊltɪdʒ ˈfɒləʊə(r)",[["n.","电压跟随器","a buffer circuit whose output voltage follows the input, with unity gain","The voltage follower prevents the source from being loaded. 电压跟随器避免信号源被负载拉垮。",["unity-gain buffer 单位增益缓冲"]]],null,[["buffer","n. 缓冲器"],["op-amp","n. 运算放大器"]],"电压跟随器输入阻抗高、输出阻抗低。","analog"],
  ["differential amplifier","n.","ˌdɪfəˈrenʃl ˈæmplɪfaɪər","ˌdɪfəˈrenʃl ˈæmplɪfaɪə(r)",[["n.","差分放大器","an amplifier that amplifies the difference between two inputs and rejects common-mode signals","The differential amplifier drives the ADC with a balanced signal. 差分放大器用平衡信号驱动 ADC。",["fully differential 全差分","input pair 输入对管"]]],null,[["common-mode","n. 共模"],["CMRR","n. 共模抑制比"]],"差分放大器的第一级通常是一对匹配的输入晶体管。","analog"],
  ["instrumentation amplifier","n.","ˌɪnstrəmenˈteɪʃn ˈæmplɪfaɪər","ˌɪnstrəmenˈteɪʃn ˈæmplɪfaɪə(r)",[["n.","仪表放大器","a precision differential amplifier with high input impedance and adjustable gain","The instrumentation amplifier amplifies the bridge sensor signal. 仪表放大器放大电桥传感器信号。",["INA 仪表放大器简称","gain resistor 增益电阻"]]],null,[["differential amplifier","n. 差分放大器"],["CMRR","n. 共模抑制比"]],"仪表放大器常用于传感器信号调理，增益由一只电阻设定。","analog"],
  ["transimpedance amplifier","n.","ˌtrænzɪmˈpiːdns ˈæmplɪfaɪər","ˌtrænzɪmˈpiːdns ˈæmplɪfaɪə(r)",[["n.","跨阻放大器","an amplifier that converts input current to output voltage","A transimpedance amplifier reads the photodiode current. 跨阻放大器读取光电二极管的电流。",["TIA 跨阻放大器简称","feedback resistor 反馈电阻"]]],null,[["photodiode","n. 光电二极管"],["op-amp","n. 运算放大器"]],"TIA 常用在光电探测与电流测量前端。","analog"],
  ["power amplifier","n.","ˈpaʊər ˈæmplɪfaɪər","ˈpaʊə(r) ˈæmplɪfaɪə(r)",[["n.","功率放大器","an amplifier that delivers high power to a load such as a speaker","The class-D power amplifier drives the speaker with high efficiency. D 类功率放大器高效驱动扬声器。",["class-AB amplifier AB 类放大器","output stage 输出级"]]],null,[["amplifier","n. 放大器"],["efficiency","n. 效率"]],"功率放大器关注输出功率、效率与失真。","analog"],
  ["preamplifier","n.","priːˈæmplɪfaɪər","priːˈæmplɪfaɪə(r)",[["n.","前置放大器","a low-noise amplifier placed before the main amplifier to boost weak signals","The preamplifier brings the microphone signal up to line level. 前置放大器把麦克风信号提升到线路电平。",["low-noise preamp 低噪声前置放大"]]],null,[["amplifier","n. 放大器"],["noise figure","n. 噪声系数"]],"前级的噪声系数决定了整个系统的噪声性能。","analog"],
  ["current mirror","n.","ˈkɜːrənt ˈmɪrər","ˈkʌrənt ˈmɪrə(r)",[["n.","电流镜","a circuit that copies a reference current to another branch","The current mirror biases the differential pair. 电流镜为差分对提供偏置电流。",["cascode current mirror 共源共栅电流镜","mirror ratio 镜像比"]]],null,[["current source","n. 电流源"],["bias","n. 偏置"]],"电流镜是模拟 IC 中最基本的构建模块之一。","analog"],
  ["current source","n.","ˈkɜːrənt sɔːrs","ˈkʌrənt sɔːs",[["n.","电流源","a circuit that supplies a constant current regardless of load voltage","Use a current source to bias the LED at 20mA. 用电流源把 LED 偏置在20毫安。",["constant current source 恒流源"]]],null,[["current sink","n. 电流阱"],["current mirror","n. 电流镜"]],"理想电流源输出阻抗无穷大。","analog"],
  ["current sink","n.","ˈkɜːrənt sɪŋk","ˈkʌrənt sɪŋk",[["n.","电流阱","a circuit that absorbs a constant current from its node","The open-drain output sinks current to ground. 开漏输出把电流吸入地。",["current-sinking output 灌电流输出"]]],null,[["current source","n. 电流源"],["sink","v. 吸收"]],"灌电流（sink）与拉电流（source）相对。","analog"],
  ["voltage divider","n.","ˈvoʊltɪdʒ dɪˈvaɪdər","ˈvəʊltɪdʒ dɪˈvaɪdə(r)",[["n.","分压器","two series resistors that produce a fraction of the input voltage","The voltage divider sets the feedback voltage to 0.8V. 分压器把反馈电压设定为0.8伏。",["resistor divider 电阻分压","divider ratio 分压比"]]],null,[["resistor","n. 电阻"],["feedback","n. 反馈"]],"Vout = Vin × R2/(R1+R2)。","analog"],
  ["cascode","n. adj.","kæsˈkoʊd","kæsˈkəʊd",[["n.","共源共栅","a two-transistor stack (common-source + common-gate) that raises output impedance","The cascode stage improves the output resistance of the current mirror. 共源共栅结构提高电流镜的输出电阻。",["cascode amplifier 共源共栅放大器","folded cascode 折叠式共源共栅"]]],null,[["output resistance","n. 输出电阻"],["Miller effect","n. 密勒效应"]],"cascode 也降低密勒效应，提高带宽。","analog"],
  ["level shifter","n.","ˈlevl ˈʃɪftər","ˈlevl ˈʃɪftə(r)",[["n.","电平移位器","a circuit that changes the DC level of a signal between domains","The level shifter converts 1.8V logic to 3.3V. 电平移位器把1.8伏逻辑转换为3.3伏。",["voltage level shifter 电压电平移位器"]]],null,[["domain","n. 域"],["voltage","n. 电压"]],"跨电压域接口都需要电平移位。","analog"],
  ["common-mode","adj. n.","ˈkɑːmən moʊd","ˈkɒmən məʊd",[["adj.","共模的","the component of a signal that is identical on both inputs","The amplifier rejects common-mode interference from the cable. 放大器抑制电缆引入的共模干扰。",["common-mode voltage 共模电压","common-mode rejection 共模抑制"]]],null,[["differential","adj. 差分的"],["CMRR","n. 共模抑制比"]],"共模信号是两输入端相同的部分，差模信号是两者之差。","analog"],
  ["differential","adj.","ˌdɪfəˈrenʃl","ˌdɪfəˈrenʃl",[["adj.","差分的；差动的","using the difference between two signals, rejecting common-mode noise","The differential pair cancels supply noise. 差分对消除电源噪声。",["differential pair 差分对","differential signal 差分信号"]]],null,[["common-mode","n. 共模"],["single-ended","adj. 单端的"]],"差分信号抗干扰能力强，是高速接口的主流。","analog"],
  ["CMRR","n.","ˌsiː em ɑːr ˈɑːr","ˌsiː em ɑːr ˈɑː(r)",[["n.","共模抑制比","Common-Mode Rejection Ratio, the ratio of differential gain to common-mode gain","A good instrumentation amplifier has a CMRR above 100dB. 好的仪表放大器共模抑制比超过100分贝。",["high CMRR 高共模抑制比"]]],null,[["common-mode","n. 共模"],["differential amplifier","n. 差分放大器"]],"CMRR 越高，抑制共模干扰的能力越强。","analog"],
  ["PSRR","n.","ˌpiː es ɑːr ˈɑːr","ˌpiː es ɑːr ˈɑː(r)",[["n.","电源抑制比","Power Supply Rejection Ratio, how well a circuit rejects supply ripple","A high PSRR keeps the output clean despite supply noise. 高电源抑制比让输出免受电源噪声影响。",["PSRR at 1MHz 1兆赫下的电源抑制比"]]],null,[["ripple","n. 纹波"],["supply","n. 电源"]],"LDO 的低频 PSRR 通常优于开关电源。","analog"],

/* ============ 模拟 IC 扩充：频率响应与稳定性 (analog) ============ */
  ["pole","n.","poʊl","pəʊl",[["n.","极点","a frequency where the transfer function rolls off by -20dB/decade","Each pole adds -90 degrees of phase shift. 每个极点引入-90度相移。",["dominant pole 主极点","pole-zero plot 零极点图"]]],null,[["zero","n. 零点"],["stability","n. 稳定性"]],"极点使增益随频率下降，是频率响应的基本构成。","analog"],
  ["zero","n.","ˈzɪroʊ","ˈzɪərəʊ",[["n.","零点","a frequency where the transfer function rises, adding +90 degrees of phase","A zero in the loop can improve the phase margin. 环路中的零点可以改善相位裕度。",["pole-zero pair 零极点对"]]],null,[["pole","n. 极点"],["phase margin","n. 相位裕度"]],"此义项为专业义；通用义（数字零）见词条首部；复数 zeros。","analog"],
  ["dominant pole","n.","ˈdɑːmɪnənt poʊl","ˈdɒmɪnənt pəʊl",[["n.","主极点","the lowest-frequency pole that dominates the frequency response","Move the dominant pole lower to make the amplifier stable. 把主极点移低以使放大器稳定。",["pole splitting 极点分裂"]]],null,[["pole","n. 极点"],["compensation","n. 补偿"]],"补偿的目的通常就是拉开主次极点。","analog"],
  ["compensation","n.","ˌkɑːmpenˈseɪʃn","ˌkɒmpenˈseɪʃn",[["n.","补偿","the technique of modifying a circuit's frequency response to ensure stability","Miller compensation stabilizes the two-stage op-amp. 密勒补偿使两级运放稳定。",["frequency compensation 频率补偿","compensation capacitor 补偿电容"]]],null,[["phase margin","n. 相位裕度"],["Miller effect","n. 密勒效应"]],"补偿电容通常接在运放第二级输入输出之间。","analog"],
  ["Miller effect","n.","ˈmɪlər ɪˈfekt","ˈmɪlər ɪˈfekt",[["n.","密勒效应","the multiplication of a feedback capacitance by the stage gain","The Miller effect turns the small Cgd into a large input capacitance. 密勒效应把很小的栅漏电容放大为大的输入电容。",["Miller capacitance 密勒电容","pole splitting 极点分裂"]]],null,[["capacitance","n. 电容"],["compensation","n. 补偿"]],"密勒效应降低增益级带宽，也被利用来做补偿。","analog"],
  ["phase margin","n.","ˈfeɪz ˈmɑːrdʒɪn","ˈfeɪz ˈmɑːdʒɪn",[["n.","相位裕度","the phase difference between -180 degrees and the loop phase at unity gain","Design for at least 60 degrees of phase margin. 设计时保证至少60度相位裕度。",["60-degree margin 60度裕度","loop stability 环路稳定"]]],null,[["gain margin","n. 增益裕度"],["stability","n. 稳定性"]],"相位裕度不足会导致闭环振铃或振荡。","analog"],
  ["gain margin","n.","ˈɡeɪn ˈmɑːrdʒɪn","ˈɡeɪn ˈmɑːdʒɪn",[["n.","增益裕度","how much loop gain can increase before instability occurs","Keep the gain margin above 10dB for robustness. 增益裕度保持在10分贝以上以保证鲁棒性。"]],null,[["phase margin","n. 相位裕度"],["stability","n. 稳定性"]],"增益裕度与相位裕度共同决定闭环稳定性。","analog"],
  ["unity-gain frequency","n.","ˈjuːnəti ɡeɪn ˈfriːkwənsi","ˈjuːnəti ɡeɪn ˈfriːkwənsi",[["n.","单位增益频率","the frequency where the open-loop gain falls to 1 (0dB)","The op-amp has a unity-gain frequency of 10MHz. 该运放的单位增益频率为10兆赫。",["GBW 增益带宽积","crossover frequency 穿越频率"]]],null,[["bandwidth","n. 带宽"],["gain","n. 增益"]],"单极点系统下单位增益频率即增益带宽积 GBW。","analog"],
  ["frequency response","n.","ˈfriːkwənsi rɪˈspɑːns","ˈfriːkwənsi rɪˈspɒns",[["n.","频率响应","how a circuit's gain and phase vary with frequency","Measure the frequency response with a network analyzer. 用网络分析仪测量频率响应。",["flat response 平坦响应","-3dB point -3分贝点"]]],null,[["bandwidth","n. 带宽"],["Bode plot","n. 波特图"]],"频率响应通常用幅频与相频曲线表示。","analog"],
  ["Bode plot","n.","ˈboʊdi plɑːt","ˈbəʊdi plɒt",[["n.","波特图","two plots of gain and phase versus frequency on logarithmic axes","The Bode plot shows the gain crossing 0dB at 1MHz. 波特图显示增益在1兆赫处穿过0分贝。",["Bode diagram 波特图"]]],null,[["frequency response","n. 频率响应"],["phase margin","n. 相位裕度"]],"波特图是分析环路稳定性的标准工具。","analog"],
  ["open-loop gain","n.","ˌoʊpən luːp ɡeɪn","ˌəʊpən luːp ɡeɪn",[["n.","开环增益","the gain of an amplifier without feedback","The op-amp open-loop gain is 100dB at DC. 运放直流开环增益为100分贝。",["open-loop response 开环响应"]]],null,[["closed-loop gain","n. 闭环增益"],["feedback","n. 反馈"]],"运放的虚短虚断以高开环增益为前提。","analog"],
  ["closed-loop gain","n.","ˌkloʊzd luːp ɡeɪn","ˌkləʊzd luːp ɡeɪn",[["n.","闭环增益","the gain of an amplifier with feedback applied","The closed-loop gain is set by the resistor ratio. 闭环增益由电阻比值决定。",["gain accuracy 增益精度"]]],null,[["open-loop gain","n. 开环增益"],["feedback","n. 反馈"]],"闭环增益由反馈网络决定，与开环增益关系小。","analog"],
  ["slew rate","n.","ˈsluː reɪt","ˈsluː reɪt",[["n.","压摆率","the maximum rate of change of the output voltage","A high slew rate is needed for large-signal fast steps. 大信号快速阶跃需要高压摆率。",["SR limit 压摆率受限","full-power bandwidth 全功率带宽"]]],null,[["settling time","n. 建立时间"],["bandwidth","n. 带宽"]],"压摆率单位 V/μs；不足会导致输出失真（slewing）。","analog"],
  ["settling time","n.","ˈsetlɪŋ taɪm","ˈsetlɪŋ taɪm",[["n.","建立时间","the time for the output to reach and stay within a specified error band","The DAC settles to 0.01% in 2 microseconds. DAC 在2微秒内建立到0.01%精度。",["settling accuracy 建立精度"]]],null,[["slew rate","n. 压摆率"],["transient response","n. 瞬态响应"]],"建立时间是 ADC 采样保持与运放的关键指标。","analog"],

/* ============ 模拟 IC 扩充：噪声与失真 (analog) ============ */
  ["thermal noise","n.","ˈθɜːrml nɔɪz","ˈθɜːml nɔɪz",[["n.","热噪声","random noise from the thermal motion of electrons, proportional to temperature","Thermal noise limits the minimum detectable signal. 热噪声限制了可检测的最小信号。",["Johnson noise 约翰逊噪声","kT/C noise 采样热噪声"]]],null,[["noise","n. 噪声"],["SNR","n. 信噪比"]],"热噪声功率 = 4kTRB。","analog"],
  ["flicker noise","n.","ˈflɪkər nɔɪz","ˈflɪkə(r) nɔɪz",[["n.","闪烁噪声（1/f 噪声）","low-frequency noise whose power increases as frequency decreases","Flicker noise dominates below 1kHz in CMOS. CMOS 中1千赫以下闪烁噪声占主导。",["1/f noise 1/f 噪声","corner frequency 转角频率"]]],null,[["noise","n. 噪声"],["corner frequency","n. 转角频率"]],"斩波（chopping）与相关双采样可抑制闪烁噪声。","analog"],
  ["shot noise","n.","ˈʃɑːt nɔɪz","ˈʃɒt nɔɪz",[["n.","散粒噪声","noise caused by the discrete nature of charge carriers crossing a junction","Shot noise appears in diode and transistor currents. 散粒噪声出现在二极管与晶体管的电流中。"]],null,[["noise","n. 噪声"],["diode","n. 二极管"]],"散粒噪声与平均电流的平方根成正比。","analog"],
  ["noise figure","n.","ˈnɔɪz ˈfɪɡjər","ˈnɔɪz ˈfɪɡə(r)",[["n.","噪声系数","the ratio of input SNR to output SNR, in decibels","The LNA has a noise figure of 1.2dB. 低噪声放大器噪声系数为1.2分贝。",["low noise figure 低噪声系数","NF 噪声系数简称"]]],null,[["SNR","n. 信噪比"],["preamplifier","n. 前置放大器"]],"级联系统第一级的噪声系数最影响总噪声。","analog"],
  ["THD","n.","ˌtiː eɪtʃ ˈdiː","ˌtiː eɪtʃ ˈdiː",[["n.","总谐波失真","Total Harmonic Distortion, the ratio of harmonic power to fundamental power","The audio amplifier has a THD of less than 0.01%. 该音频放大器总谐波失真小于0.01%。",["THD+N 含噪声的总谐波失真"]]],null,[["distortion","n. 失真"],["SFDR","n. 无杂散动态范围"]],"THD 越低，放大器输出越保真。","analog"],
  ["SFDR","n.","ˌes ef diː ˈɑːr","ˌes ef diː ˈɑːr",[["n.","无杂散动态范围","Spurious-Free Dynamic Range, the ratio of the signal to the largest spurious tone","The ADC SFDR exceeds 90dB for a full-scale tone. 该 ADC 对满量程信号的 SFDR 超过90分贝。"]],null,[["THD","n. 总谐波失真"],["ADC","n. 模数转换器"]],"SFDR 衡量信号相对最大杂散的动态范围。","analog"],
  ["SINAD","n.","ˈsaɪnæd","ˈsaɪnæd",[["n.","信纳比","Signal-to-Noise-and-Distortion ratio, combining noise and distortion","SINAD is used to derive the effective number of bits. 用信纳比推导有效位数。"]],null,[["ENOB","n. 有效位数"],["SNR","n. 信噪比"]],"SINAD 与 ENOB 的关系：ENOB=(SINAD-1.76)/6.02。","analog"],
  ["ENOB","n.","ˈiːnɑːb","ˈiːnɒb",[["n.","有效位数","Effective Number of Bits, the real resolution of an ADC considering noise and distortion","A 16-bit ADC with 80dB SINAD has an ENOB of about 13. 16位 ADC 若 SINAD 为80分贝，ENOB 约13位。",["effective bits 有效位"]]],null,[["SINAD","n. 信纳比"],["resolution","n. 分辨率"]],"ENOB 比标称位数更真实地反映转换器性能。","analog"],
  ["crossover distortion","n.","ˈkrɔːsoʊvər dɪˈstɔːrʃn","ˈkrɒsəʊvə(r) dɪˈstɔːʃn",[["n.","交越失真","distortion that occurs when the output stage switches between push and pull transistors","Class-B output stages suffer from crossover distortion. B 类输出级存在交越失真。",["class-AB 甲乙类"]]],null,[["distortion","n. 失真"],["power amplifier","n. 功率放大器"]],"AB 类输出级通过偏置消除交越失真。","analog"],
  ["clipping","n.","ˈklɪpɪŋ","ˈklɪpɪŋ",[["n.","削波","the flattening of a waveform when the output exceeds the supply rails","Clipping adds strong harmonics to the audio signal. 削波给音频信号引入大量谐波。",["hard clipping 硬削波"]]],null,[["distortion","n. 失真"],["saturation","n. 饱和"]],"输出超过电源轨时波形被「削平」。","analog"],
  ["jitter","n.","ˈdʒɪtər","ˈdʒɪtə(r)",[["n.","抖动","the short-term variation of a clock edge from its ideal position","Clock jitter degrades the ADC SNR at high frequencies. 时钟抖动在高频下降低 ADC 的信噪比。",["clock jitter 时钟抖动","random jitter 随机抖动","deterministic jitter 确定性抖动"]]],null,[["phase noise","n. 相位噪声"],["clock","n. 时钟"]],"抖动与相位噪声分别是时域与频域的描述。","analog"],
  ["phase noise","n.","ˈfeɪz nɔɪz","ˈfeɪz nɔɪz",[["n.","相位噪声","random phase fluctuations of an oscillator, measured in dBc/Hz","The VCO phase noise is -120dBc/Hz at 1MHz offset. 该 VCO 在1兆赫偏移处相位噪声为-120dBc/Hz。"]],null,[["jitter","n. 抖动"],["VCO","n. 压控振荡器"]],"相位噪声影响通信系统的误码率。","analog"],

/* ============ 模拟 IC 扩充：数据转换 (analog) ============ */
  ["LSB","n.","ˌel es ˈbiː","ˌel es ˈbiː",[["n.","最低有效位","Least Significant Bit, the smallest step a converter can represent","One LSB of a 12-bit ADC equals full-scale divided by 4096. 12位 ADC 的一个 LSB 等于满量程除以4096。",["LSB error 最低位误差"]]],null,[["MSB","n. 最高有效位"],["resolution","n. 分辨率"]],"量化误差最大为 ±0.5 LSB。","analog"],
  ["MSB","n.","ˌem es ˈbiː","ˌem es ˈbiː",[["n.","最高有效位","Most Significant Bit, the bit with the largest weight in a binary number","The MSB of the output code indicates the sign in bipolar ADCs. 双极性 ADC 中输出编码的最高位表示符号。"]],null,[["LSB","n. 最低有效位"],["binary","adj. 二进制的"]],"MSB 的变化对应满量程的一半。","analog"],
  ["full-scale","adj. n.","ˌfʊl ˈskeɪl","ˌfʊl ˈskeɪl",[["n.","满量程","the maximum input or output range of a converter","The ADC accepts a full-scale input of 3.3V. 该 ADC 满量程输入为3.3伏。",["full-scale range 满量程范围","full-scale error 满量程误差"]]],null,[["resolution","n. 分辨率"],["range","n. 量程"]],"满量程对应的数字编码为 2^N-1。","analog"],
  ["DNL","n.","ˌdiː en ˈel","ˌdiː en ˈel",[["n.","微分非线性","Differential Non-Linearity, the deviation of each step width from one LSB","A DNL below 1 LSB guarantees no missing codes. DNL 小于1个 LSB 保证无漏码。",["missing code 漏码"]]],null,[["INL","n. 积分非线性"],["monotonicity","n. 单调性"]],"DNL>1 LSB 会出现漏码（missing code）。","analog"],
  ["INL","n.","ˌaɪ en ˈel","ˌaɪ en ˈel",[["n.","积分非线性","Integral Non-Linearity, the deviation of the transfer curve from an ideal straight line","The INL of the DAC is within plus or minus 2 LSB. 该 DAC 的 INL 在正负2个 LSB 以内。"]],null,[["DNL","n. 微分非线性"],["linearity","n. 线性度"]],"INL 是 DNL 的累积。","analog"],
  ["sample-and-hold","n.","ˌsæmpl ən ˈhoʊld","ˌsɑːmpl ən ˈhəʊld",[["n.","采样保持","a circuit that captures an analog voltage and holds it during conversion","The sample-and-hold keeps the ADC input stable during conversion. 采样保持电路在转换期间保持 ADC 输入稳定。",["track-and-hold 跟踪保持","aperture time 孔径时间"]]],null,[["ADC","n. 模数转换器"],["sampling","n. 采样"]],"采样保持的孔径误差限制高频输入下的精度。","analog"],
  ["successive approximation","n.","səkˈsesɪv əˌprɑːksɪˈmeɪʃn","səkˈsesɪv əˌprɒksɪˈmeɪʃn",[["n.","逐次逼近","an ADC algorithm that determines each bit by binary search against a DAC","Successive approximation needs N clock cycles for N bits. 逐次逼近 N 位转换需要 N 个时钟周期。",["SAR ADC 逐次逼近型 ADC"]]],null,[["SAR","n. 逐次逼近寄存器"],["comparator","n. 比较器"]],"SAR ADC 在功耗与速度间取得良好平衡。","analog"],
  ["SAR","n.","ˌes eɪ ˈɑːr","ˌes eɪ ˈɑːr",[["n.","逐次逼近寄存器","Successive Approximation Register, the digital logic that controls the SAR ADC search","The SAR decides each bit by comparing the DAC output with the input. 逐次逼近寄存器通过比较 DAC 输出与输入来决定每一位。",["SAR logic 逐次逼近逻辑"]]],null,[["successive approximation","n. 逐次逼近"],["comparator","n. 比较器"]],"SAR ADC 结构简单、功耗低，是中速高精度主流。","analog"],
  ["flash ADC","n.","ˌflæʃ ˌeɪ diː ˈsiː","ˌflæʃ ˌeɪ diː ˈsiː",[["n.","闪存型 ADC（并行比较型）","an ultra-fast ADC using 2^N-1 comparators in parallel","A flash ADC converts in a single clock cycle but needs many comparators. 闪存型 ADC 一个周期完成转换，但需要大量比较器。",["thermometer code 温度计码"]]],null,[["comparator","n. 比较器"],["ADC","n. 模数转换器"]],"8 位闪存型 ADC 需要 255 个比较器，面积功耗巨大。","analog"],
  ["pipeline ADC","n.","ˈpaɪplaɪn ˌeɪ diː ˈsiː","ˈpaɪplaɪn ˌeɪ diː ˈsiː",[["n.","流水线型 ADC","an ADC that converts in stages with overlapping pipeline stages","The pipeline ADC achieves high speed with modest power. 流水线型 ADC 以适中功耗实现高速度。",["stage resolution 每级位数","digital correction 数字校正"]]],null,[["ADC","n. 模数转换器"],["pipeline","n. 流水线"]],"流水线 ADC 常用于视频与通信中速高精度场合。","analog"],
  ["delta-sigma","n. adj.","ˈdeltə ˈsɪɡmə","ˈdeltə ˈsɪɡmə",[["n.","Δ-Σ（增量-总和）调制器","an oversampling converter that trades speed for resolution using noise shaping","The delta-sigma ADC achieves 24-bit resolution with oversampling. Δ-Σ ADC 通过过采样实现24位分辨率。",["delta-sigma modulator Δ-Σ 调制器","noise shaping 噪声整形"]]],null,[["ADC","n. 模数转换器"],["oversampling","n. 过采样"]],"Δ-Σ 通过噪声整形把量化噪声推到带外。","analog"],
  ["switched capacitor","n. adj.","ˌswɪtʃt kəˈpæsɪtər","ˌswɪtʃt kəˈpæsɪtə(r)",[["n.","开关电容","a circuit technique that emulates resistors using switches and capacitors","Switched-capacitor filters set their time constant by the clock frequency. 开关电容滤波器用时钟频率设定时间常数。",["switched-capacitor filter 开关电容滤波器","charge transfer 电荷转移"]]],null,[["capacitor","n. 电容"],["charge","n. 电荷"]],"开关电容的等效电阻 Req = 1/(f·C)。","analog"],
  ["correlated double sampling","n.","ˌkɔːrəleɪtɪd ˈdʌbl ˈsæmplɪŋ","ˌkɒrəleɪtɪd ˈdʌbl ˈsɑːmplɪŋ",[["n.","相关双采样（CDS）","a technique that removes fixed-pattern noise by subtracting two samples","Correlated double sampling cancels the reset noise of the pixel. 相关双采样消除像素的复位噪声。",["CDS 相关双采样简称","fixed-pattern noise 固定模式噪声"]]],null,[["flicker noise","n. 闪烁噪声"],["noise","n. 噪声"]],"CDS 广泛用于图像传感器与斩波放大器。","analog"],
  ["integrator","n.","ˈɪntɪɡreɪtər","ˈɪntɪɡreɪtə(r)",[["n.","积分器","an op-amp circuit whose output is the time integral of the input","The integrator accumulates the charge in the delta-sigma modulator. 积分器在 Δ-Σ 调制器中累积电荷。",["Miller integrator 密勒积分器","leaky integrator 有损积分器"]]],null,[["op-amp","n. 运算放大器"],["capacitor","n. 电容"]],"理想积分器输出随时间线性变化。","analog"],
  ["differentiator","n.","ˌdɪfəˈrenʃieɪtər","ˌdɪfəˈrenʃieɪtə(r)",[["n.","微分器","an op-amp circuit whose output is proportional to the rate of change of the input","The differentiator amplifies high-frequency noise, so it needs a series resistor. 微分器放大高频噪声，需要串联电阻抑制。"]],null,[["integrator","n. 积分器"],["op-amp","n. 运算放大器"]],"实际微分器会加电阻限制高频增益。","analog"],

/* ============ 模拟 IC 扩充：时钟与锁相环 (analog) ============ */
  ["PLL","n.","ˌpiː el ˈel","ˌpiː el ˈel",[["n.","锁相环","Phase-Locked Loop, a feedback system that locks an oscillator to a reference frequency","The PLL multiplies the 32kHz crystal up to 48MHz. 锁相环把32千赫晶振倍频到48兆赫。",["PLL loop filter 环路滤波器","charge-pump PLL 电荷泵锁相环","fractional-N PLL 分数分频锁相环"]]],null,[["VCO","n. 压控振荡器"],["phase detector","n. 鉴相器"],["loop filter","n. 环路滤波器"]],"PLL 由鉴相器、环路滤波器、VCO 与分频器组成。","analog"],
  ["VCO","n.","ˌviː siː ˈoʊ","ˌviː siː ˈəʊ",[["n.","压控振荡器","Voltage-Controlled Oscillator, whose frequency is set by a control voltage","The VCO gain K_vco is measured in MHz/V. 压控振荡器增益 K_vco 的单位是兆赫/伏。",["LC VCO LC 压控振荡器","ring VCO 环形压控振荡器"]]],null,[["PLL","n. 锁相环"],["oscillator","n. 振荡器"]],"VCO 的调谐范围与相位噪声是一对矛盾。","analog"],
  ["phase detector","n.","ˈfeɪz dɪˈtektər","ˈfeɪz dɪˈtektə(r)",[["n.","鉴相器","a circuit that compares the phase of two signals in a PLL","The phase detector outputs a voltage proportional to the phase error. 鉴相器输出与相位误差成正比的电压。",["PFD 鉴频鉴相器","dead zone 死区"]]],null,[["PLL","n. 锁相环"],["phase","n. 相位"]],"鉴频鉴相器（PFD）同时检测频率与相位误差。","analog"],
  ["frequency divider","n.","ˈfriːkwənsi dɪˈvaɪdər","ˈfriːkwənsi dɪˈvaɪdə(r)",[["n.","分频器","a circuit that divides a clock frequency by an integer ratio","The frequency divider lets the PLL lock to a fraction of the VCO frequency. 分频器让锁相环锁定到 VCO 频率的整数分之一。",["prescaler 预分频器","multi-modulus divider 多模分频器"]]],null,[["PLL","n. 锁相环"],["frequency","n. 频率"]],"分频比 N 决定 PLL 的输出频率。","analog"],
  ["duty cycle","n.","ˈduːti ˈsaɪkl","ˈdjuːti ˈsaɪkl",[["n.","占空比","the fraction of one period during which a signal is high","Set the PWM duty cycle to 50% for a balanced output. 把 PWM 占空比设为50%以获得平衡输出。",["50% duty cycle 50%占空比"]]],null,[["PWM","n. 脉冲宽度调制"],["period","n. 周期"]],"占空比 = 高电平时间 / 周期。","analog"],
  ["loop filter","n.","ˈluːp ˈfɪltər","ˈluːp ˈfɪltə(r)",[["n.","环路滤波器","the low-pass filter in a PLL that sets its bandwidth and stability","Widen the loop filter bandwidth to reduce lock time. 加大环路滤波器带宽以缩短锁定时间。",["loop bandwidth 环路带宽","charge pump filter 电荷泵滤波器"]]],null,[["PLL","n. 锁相环"],["filter","n. 滤波器"]],"环路带宽决定 PLL 的锁定速度与相位噪声。","analog"],
  ["crystal","n.","ˈkrɪstl","ˈkrɪstl",[["n.","石英晶体；晶振","a quartz resonator that provides a precise reference frequency","The 16MHz crystal provides the system reference clock. 16兆赫晶振提供系统参考时钟。",["crystal oscillator 晶体振荡器","crystal load capacitance 晶振负载电容"]]],null,[["oscillator","n. 振荡器"],["PLL","n. 锁相环"]],"晶振频率精度远高于 RC 振荡器。","analog"],
  ["bandgap","n.","ˈbændɡæp","ˈbændɡæp",[["n.","带隙（基准）","a voltage reference circuit producing about 1.2V independent of temperature","The bandgap reference is trimmed to 1.25V at room temperature. 带隙基准在室温下被校准到1.25伏。",["bandgap reference 带隙基准","PTAT voltage 正温度系数电压"]]],null,[["reference","n. 基准"],["temperature coefficient","n. 温度系数"]],"带隙基准利用正负温度系数电压相加实现零温漂。","analog"],

/* ============ 模拟 IC 扩充：器件物理 (analog) ============ */
  ["threshold","n.","ˈθreʃhoʊld","ˈθreʃhəʊld",[["n.","阈值","the boundary value at which a device changes state, such as threshold voltage","The comparator switches when the input crosses the threshold. 输入越过阈值时比较器翻转。",["threshold voltage 阈值电压","switching threshold 翻转阈值"]]],null,[["comparator","n. 比较器"],["voltage","n. 电压"]],"MOSFET 的阈值电压 Vth 是栅极开启导电沟道的最小电压。","analog"],
  ["overdrive","n. v.","ˈoʊvərdraɪv","ˈəʊvədraɪv",[["n.","过驱动电压","the gate voltage above the threshold (Vgs - Vth) in a MOSFET","A larger overdrive voltage increases the drain current. 更大的过驱动电压增大漏极电流。",["overdrive voltage 过驱动电压","strong inversion 强反型"]]],null,[["threshold","n. 阈值"],["transconductance","n. 跨导"]],"过驱动电压 Vov = Vgs - Vth。","analog"],
  ["subthreshold","adj.","sʌbˈθreʃhoʊld","sʌbˈθreʃhəʊld",[["adj.","亚阈值的","operating below the threshold voltage with exponential current","Subthreshold operation is used for ultra-low-power circuits. 亚阈值工作用于超低功耗电路。",["subthreshold current 亚阈值电流","weak inversion 弱反型"]]],null,[["weak inversion","n. 弱反型"],["threshold","n. 阈值"]],"亚阈值区电流随栅压指数变化，泄漏大。","analog"],
  ["weak inversion","n.","ˌwiːk ɪnˈvɜːrʒn","ˌwiːk ɪnˈvɜːʃn",[["n.","弱反型","the MOSFET region below threshold where current is exponential in gate voltage","Designers use weak inversion for energy-efficient analog blocks. 设计师利用弱反型实现高能效模拟模块。"]],null,[["subthreshold","adj. 亚阈值的"],["strong inversion","n. 强反型"]],"弱反型下 gm/Id 最大，但速度慢、失配大。","analog"],
  ["body effect","n.","ˈbɑːdi ɪˈfekt","ˈbɒdi ɪˈfekt",[["n.","衬底效应","the change of threshold voltage caused by source-bulk voltage","The body effect shifts Vth when the source is not connected to the bulk. 源极未接衬底时衬底效应使阈值电压偏移。",["back-gate effect 背栅效应"]]],null,[["threshold","n. 阈值"],["MOSFET","n. 金属氧化物半导体场效应管"]],"衬底效应系数 γ 取决于工艺参数。","analog"],
  ["Early effect","n.","ˈɜːrli ɪˈfekt","ˈɜːli ɪˈfekt",[["n.","厄利效应","the dependence of collector (or drain) current on output voltage in transistors","The Early effect limits the output resistance of current sources. 厄利效应限制了电流源的输出电阻。",["Early voltage 厄利电压"]]],null,[["output resistance","n. 输出电阻"],["BJT","n. 双极结型晶体管"]],"厄利电压 VA 越大，输出电阻越高。","analog"],
  ["channel length modulation","n.","ˈtʃænl leŋθ ˌmɑːdʒuˈleɪʃn","ˈtʃænl leŋθ ˌmɒdʒuˈleɪʃn",[["n.","沟道长度调制","the shortening of the effective channel that increases drain current with Vds","Channel length modulation gives MOSFETs a finite output resistance. 沟道长度调制使 MOSFET 输出电阻有限。",["lambda 沟道长度调制系数"]]],null,[["Early effect","n. 厄利效应"],["output resistance","n. 输出电阻"]],"长沟道器件 λ 小，输出电阻大。","analog"],
  ["transconductance","n.","ˌtrænzkənˈdʌktəns","ˌtrænzkənˈdʌktəns",[["n.","跨导","the change of output current per change of input voltage (gm)","The transconductance of the transistor sets the amplifier gain. 晶体管的跨导决定放大器增益。",["gm 跨导","gm/Id ratio 跨导电流比"]]],null,[["gain","n. 增益"],["MOSFET","n. 金属氧化物半导体场效应管"]],"gm = ΔId/ΔVgs，单位西门子 S。","analog"],
  ["drain current","n.","ˈdreɪn ˈkɜːrənt","ˈdreɪn ˈkʌrənt",[["n.","漏极电流","the current flowing into the drain terminal of a MOSFET","The drain current is set by the bias point in the saturation region. 漏极电流由饱和区的偏置点决定。",["quiescent drain current 静态漏电流"]]],null,[["transconductance","n. 跨导"],["bias","n. 偏置"]],"饱和区漏电流近似与 Vds 无关。","analog"],
  ["gate oxide","n.","ˈɡeɪt ˈɑːksaɪd","ˈɡeɪt ˈɒksaɪd",[["n.","栅氧化层","the thin insulating layer between the gate and channel of a MOSFET","Thinner gate oxide allows lower operating voltage but higher leakage. 更薄的栅氧化层允许更低工作电压但漏电更大。",["oxide thickness 氧化层厚度","breakdown voltage 击穿电压"]]],null,[["MOSFET","n. 金属氧化物半导体场效应管"],["capacitance","n. 电容"]],"栅氧化层厚度直接决定栅电容与可靠性。","analog"],
  ["depletion region","n.","dɪˈpliːʃn ˈriːdʒən","dɪˈpliːʃn ˈriːdʒən",[["n.","耗尽区","the charge-free region at a p-n junction or around a reversed-biased junction","The depletion region widens as the reverse voltage increases. 反向电压增大时耗尽区变宽。",["depletion width 耗尽区宽度"]]],null,[["diode","n. 二极管"],["junction","n. 结"]],"耗尽区宽度影响结电容与击穿电压。","analog"],
  ["triode region","n.","ˈtraɪoʊd ˈriːdʒən","ˈtraɪəʊd ˈriːdʒən",[["n.","三极管区（线性区）","the MOSFET region where the channel is continuous and acts like a resistor","In the triode region, the MOSFET behaves as a voltage-controlled resistor. 三极管区内 MOSFET 表现为压控电阻。",["linear region 线性区","on-resistance 导通电阻"]]],null,[["saturation","n. 饱和"],["MOSFET","n. 金属氧化物半导体场效应管"]],"开关应用中 MOSFET 工作在三极管区以减小导通损耗。","analog"],
  ["cutoff","n.","ˈkʌtɔːf","ˈkʌtɒf",[["n.","截止（区）","the transistor region where no current flows because the device is off","In cutoff, the MOSFET conducts essentially no drain current. 截止区 MOSFET 基本不导通漏极电流。",["cutoff region 截止区"]]],null,[["saturation","n. 饱和"],["triode region","n. 三极管区"]],"数字逻辑的 0 状态对应晶体管截止。","analog"],
  ["frequency","n.","ˈfriːkwənsi","ˈfriːkwənsi",[["n.","频率","the number of cycles per second of a periodic signal, in hertz","The oscillator runs at a frequency of 24MHz. 振荡器工作在24兆赫频率。",["fundamental frequency 基频","sampling frequency 采样频率"]]],null,[["period","n. 周期"],["amplitude","n. 幅度"]],"f = 1/T。","analog"],
  ["amplitude","n.","ˈæmplɪtuːd","ˈæmplɪtjuːd",[["n.","幅度；振幅","the peak value of a signal from its center","The amplitude of the sine wave is 1V peak. 该正弦波的幅度为1伏峰值。",["amplitude modulation 调幅","peak amplitude 峰值幅度"]]],null,[["frequency","n. 频率"],["phase","n. 相位"]],"幅度、频率、相位是正弦信号的三个要素。","analog"],
  ["waveform","n.","ˈweɪvfɔːrm","ˈweɪvfɔːm",[["n.","波形","the shape of a signal plotted against time","Check the waveform on the oscilloscope for ringing. 在示波器上检查波形是否有振铃。",["square waveform 方波","output waveform 输出波形"]]],null,[["oscilloscope","n. 示波器"],["signal","n. 信号"]],"常见波形：正弦、方波、三角波、锯齿波。","analog"],
  ["impedance matching","n.","ɪmˈpiːdns ˈmætʃɪŋ","ɪmˈpiːdns ˈmætʃɪŋ",[["n.","阻抗匹配","making source and load impedances equal to maximize power transfer or minimize reflections","Terminate the transmission line with 50 ohms for impedance matching. 用50欧姆端接传输线实现阻抗匹配。",["50-ohm matching 50欧姆匹配","matching network 匹配网络"]]],null,[["impedance","n. 阻抗"],["reflection","n. 反射"]],"射频与高速数字中阻抗失配会引起反射与损耗。","analog"],
  ["loading effect","n.","ˈloʊdɪŋ ɪˈfekt","ˈləʊdɪŋ ɪˈfekt",[["n.","负载效应","the change of a circuit's behavior caused by the load connected to it","A high-impedance buffer avoids the loading effect on the source. 高输入阻抗缓冲器避免对信号源的负载效应。"]],null,[["buffer","n. 缓冲器"],["impedance","n. 阻抗"]],"仪表接入被测电路时要注意负载效应。","analog"],
  ["hysteresis","n.","ˌhɪstəˈriːsɪs","ˌhɪstəˈriːsɪs",[["n.","迟滞","the difference between the rising and falling trigger thresholds","Comparator hysteresis prevents oscillation near the threshold. 比较器迟滞防止阈值附近振荡。",["hysteresis window 迟滞窗口","Schmitt trigger 施密特触发器"]]],null,[["comparator","n. 比较器"],["threshold","n. 阈值"]],"施密特触发器就是带迟滞的比较器。","analog"],
  ["latch-up","n.","ˈlætʃ ʌp","ˈlætʃ ʌp",[["n.","闩锁效应","an unwanted low-impedance path in CMOS caused by parasitic thyristors","Guard rings prevent CMOS latch-up. 保护环防止 CMOS 闩锁效应。",["latch-up immunity 抗闩锁能力","parasitic thyristor 寄生晶闸管"]]],null,[["CMOS","n. 互补金属氧化物半导体"],["ESD","n. 静电放电"]],"闩锁会导致芯片短路烧毁。","analog"],

/* ============ 模拟 IC 扩充：电源管理 (power) ============ */
  ["charge pump","n.","ˈtʃɑːrdʒ pʌmp","ˈtʃɑːdʒ pʌmp",[["n.","电荷泵","a DC-DC converter that uses capacitors and switches to transfer charge","The charge pump generates a negative rail from a positive supply. 电荷泵从正电源产生负电源轨。",["voltage doubler 倍压器","charge-pump regulator 电荷泵稳压器"]]],null,[["buck","n. 降压变换器"],["boost","n. 升压变换器"]],"电荷泵无需电感，但负载能力有限。","power"],
  ["current limit","n.","ˈkɜːrənt ˈlɪmɪt","ˈkʌrənt ˈlɪmɪt",[["n.","限流","the maximum current a supply or driver will deliver, protecting the circuit","The regulator folds back its current limit during a short circuit. 短路时稳压器折返限流。",["current limit threshold 限流阈值","overcurrent protection 过流保护"]]],null,[["protection","n. 保护"],["thermal shutdown","n. 过温保护"]],"限流防止电源过载损坏。","power"],
  ["line regulation","n.","ˈlaɪn ˌreɡjuˈleɪʃn","ˈlaɪn ˌreɡjuˈleɪʃn",[["n.","线性调整率","the change of output voltage for a change of input voltage","The LDO has a line regulation of 0.01% per volt. 该 LDO 线性调整率为每伏0.01%。"]],null,[["load regulation","n. 负载调整率"],["regulator","n. 稳压器"]],"线性调整率衡量电源对输入变化的抑制能力。","power"],
  ["load regulation","n.","ˈloʊd ˌreɡjuˈleɪʃn","ˈləʊd ˌreɡjuˈleɪʃn",[["n.","负载调整率","the change of output voltage for a change of load current","The supply shows excellent load regulation from no load to full load. 该电源从空载到满载负载调整率极佳。"]],null,[["line regulation","n. 线性调整率"],["load","n. 负载"]],"负载调整率衡量输出随负载电流的变化。","power"],
  ["transient response","n.","ˈtrænziənt rɪˈspɑːns","ˈtrænziənt rɪˈspɒns",[["n.","瞬态响应","how quickly a circuit recovers from a sudden load or input change","The regulator transient response recovers within 10 microseconds. 稳压器瞬态响应在10微秒内恢复。",["load transient 负载瞬态","settling 建立"]]],null,[["settling time","n. 建立时间"],["ripple","n. 纹波"]],"瞬态过冲与恢复时间是电源的关键指标。","power"],
  ["soft-start","n.","ˌsɔːft ˈstɑːrt","ˌsɒft ˈstɑːt",[["n.","软启动","gradually ramping up the output at power-on to limit inrush current","The soft-start circuit limits the inrush current at startup. 软启动电路限制上电时的浪涌电流。",["soft-start time 软启动时间","inrush current 浪涌电流"]]],null,[["current limit","n. 限流"],["startup","n. 启动"]],"软启动防止大电容充电电流过冲。","power"],
  ["thermal shutdown","n.","ˈθɜːrml ˈʃʌtdaʊn","ˈθɜːml ˈʃʌtdaʊn",[["n.","过温保护；热关断","a protection that turns off the chip when the die temperature is too high","The IC enters thermal shutdown at 150 degrees Celsius. 芯片在150摄氏度时进入过温保护。",["thermal protection 热保护","junction temperature 结温"]]],null,[["protection","n. 保护"],["current limit","n. 限流"]],"过温保护带迟滞，冷却后自动恢复。","power"],
  ["UVLO","n.","ˌjuː viː el ˈoʊ","ˌjuː viː el ˈəʊ",[["n.","欠压锁定","Under-Voltage Lock-Out, prevents operation when the supply is too low","The UVLO threshold is 2.9V with 100mV hysteresis. 欠压锁定阈值2.9伏，带100毫伏迟滞。",["UVLO threshold 欠压锁定阈值"]]],null,[["supply","n. 电源"],["hysteresis","n. 迟滞"]],"UVLO 防止电源电压不足时芯片工作异常。","power"]
];
